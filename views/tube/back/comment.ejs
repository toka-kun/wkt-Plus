<html>
<script src="/js/tailwindcss.js"></script>
<body class="bg-gray-900 text-white">
  <%
    // コメントが取得できなかった(null)ときは、わざとエラーにする。
    // 画面側(watch.ejs など)は、サーバーがエラーを返すと「コメントの取得に失敗しました」と
    // 「再試行」ボタンを出す。案内文を正常な応答として返すと、そのエラー表示と再試行ボタンが出ない。
    if (!cm || !Array.isArray(cm.contents)) throw new Error('コメントを取得できません');
    // 作者や本文が欠けているコメントがあっても落ちないようにする
    const threads = cm.contents.filter(c => c && c.comment);
    // 本文はそのまま HTML として出力するとコメントに書かれたタグが実行されてしまうため、先にエスケープする
    const esc = (t) => String(t)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    // "0" や空は表示しない
    const shown = (v) => (v && String(v) !== '0') ? String(v) : '';
    // 線画アイコン (色は文字色に合わせる)
    const P = {
      pin: '<path d="M12 17v5"/><path d="M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z"/>',
      like: '<path d="M7 10v12"/><path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z"/>',
      heart: '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>',
      reply: '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>',
      owner: '<path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.78 4.78 4 4 0 0 1-6.74 0 4 4 0 0 1-4.78-4.78 4 4 0 0 1 0-6.74Z"/><path d="m9 12 2 2 4-4"/>',
      member: '<path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/>'
    };
    const ic = (k, s = 'w-4 h-4', f = 'none') => '<svg class="' + s + ' shrink-0" viewBox="0 0 24 24" fill="' + f + '" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + P[k] + '</svg>';
    // 小さなラベル(ピル)の共通スタイル。1行のまま折り返さない
    const pill = 'inline-flex items-center gap-1 whitespace-nowrap rounded-full px-2 py-0.5 text-xs font-medium ring-1';
    const chip = 'inline-flex items-center gap-1.5 whitespace-nowrap rounded-full px-2.5 py-1 tabular-nums ring-1';
  %>
  <div class="mt-4 p-4 bg-gray-800 rounded-lg shadow-lg ring-1 ring-white/5">
    <div class="mt-2 space-y-4">
      <% threads.forEach(CommentThread => {
           const c = CommentThread.comment;
           const avatar = c.author?.thumbnails?.[0]?.url || '';
           const authorId = c.author?.id && c.author.id !== 'N/A' ? c.author.id : '';
           const authorName = c.author?.name || "(Unable to parse author name)";
           const body = c.content?.text || "(Unable to parse comment)";
           const likes = shown(c.like_count);
           const replies = shown(c.reply_count);
      %>
        <div class="flex items-start bg-gray-700 p-4 rounded-lg ring-1 ring-white/5 transition duration-200 transform hover:scale-101 hover:ring-white/20 hover:shadow-md motion-reduce:transition-none motion-reduce:transform-none">
          <% if (authorId) { %><a href="/wkt/c/<%= authorId %>" target="_blank" aria-label="<%= authorName %>のチャンネル" class="shrink-0 rounded-full transition hover:opacity-80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400"><% } %>
          <% if (avatar) { %>
          <img loading="lazy" src="<%= avatar %>" class="w-10 h-10 rounded-full shrink-0 object-cover ring-2 ring-gray-600">
          <% } else { %>
          <div class="w-10 h-10 rounded-full bg-gray-600 shrink-0 ring-2 ring-gray-600"></div>
          <% } %>
          <% if (authorId) { %></a><% } %>
          <div class="ml-3 min-w-0">
            <% if (c.is_pinned) { %>
            <p class="mb-1.5"><span class="<%= pill %> bg-yellow-400/15 text-yellow-300 ring-yellow-300/30"><%- ic('pin', 'w-3.5 h-3.5') %>固定されたコメント</span></p>
            <% } %>
            <p class="text-lg font-semibold tracking-tight flex flex-wrap items-center gap-x-2 gap-y-1">
              <% if (authorId) { %>
              <a href="/wkt/c/<%= authorId %>" target="_blank" class="text-blue-300 rounded underline-offset-2 hover:text-blue-200 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400"><%= authorName %></a>
              <% } else { %>
              <span class="text-blue-300"><%= authorName %></span>
              <% } %>
              <% if (c.author_is_channel_owner) { %>
              <span class="<%= pill %> bg-gray-500/40 text-gray-100 ring-white/20"><%- ic('owner', 'w-3 h-3') %>投稿者</span>
              <% } %>
              <% if (c.is_member) { %>
              <span class="<%= pill %> bg-green-500/20 text-green-300 ring-green-400/40"><%- ic('member', 'w-3 h-3') %>メンバー</span>
              <% } %>
              <% if (c.published_time) { %>
              <span class="text-sm font-normal text-gray-300"><%= c.published_time %></span>
              <% } %>
            </p>
            <p class="text-gray-300 text-lg mt-1 leading-relaxed break-words">
              <%- esc(body).replace(/\n/g, "<br>") %>
            </p>
            <% if (likes || c.is_hearted || replies) { %>
            <p class="text-sm text-gray-300 mt-3 flex flex-wrap gap-2">
              <% if (likes) { %><span class="<%= chip %> bg-gray-900/40 text-gray-200 ring-white/10"><%- ic('like') %><span class="sr-only">高評価</span><%= likes %></span><% } %>
              <% if (c.is_hearted) { %><span class="<%= chip %> bg-red-400/15 text-red-300 ring-red-300/30"><%- ic('heart', 'w-4 h-4', 'currentColor') %>投稿者がいいね</span><% } %>
              <% if (replies) { %><span class="<%= chip %> bg-gray-900/40 text-gray-200 ring-white/10"><%- ic('reply') %>返信 <%= replies %>件</span><% } %>
            </p>
            <% } %>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</body>
</html>
