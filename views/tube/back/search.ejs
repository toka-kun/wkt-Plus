<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/page.css">
    <script src="/js/tailwindcss.js"></script>
</head>
<body class="bg-gray-900 text-white">
    <div class="container mx-auto p-4">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
            <% if (typeof res !== 'undefined' && res && res.results && Array.isArray(res.results)) { %>
                <% res.results.forEach(function(video) { %>
                  <% if (video.type && video.type.endsWith("Video")) { %>
                    <div class="result-item bg-gray-800 p-4 rounded-lg shadow hover:bg-gray-700 transition duration-200">
                        <a href="/wkt/watch/<%= video.id %>" class="block relative group" target="_top">
                            <img loading="lazy" src="/wkt/back/vi/<%= video.id %>/mqdefault.jpg" alt="<%= video.title ? (video.title.text || video.title.toString()) : '' %>" class="w-full h-auto rounded aspect-video object-cover">
                            <% if (video.isLive) { %><span class="absolute bottom-1 right-1 bg-red-600 bg-opacity-90 text-white text-xs px-1.5 py-0.5 rounded font-medium">ライブ</span><% } else if (video.duration?.text) { %>
                            <span class="absolute bottom-1 right-1 bg-black bg-opacity-80 text-white text-xs px-1.5 py-0.5 rounded font-medium"><%= video.duration.text %></span>
                            <% } %>
                            <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-10 transition rounded"></div>
                        </a>
                        <div class="mt-3 flex items-start space-x-3">
                            <% if (video.author?.thumbnails?.[0]?.url) { %>
                            <a href="<%= (video.author?.id && video.author.id !== 'N/A') ? '/wkt/c/' + video.author.id : '/wkt/watch/' + video.id %>" class="flex-shrink-0" target="_top">
                                <% if (video.author.id === 'N/A') { %>
                                <img src="<%= video.author.thumbnails[0].url %>" alt="<%= video.author.name %>" class="w-9 h-9 rounded-full object-cover bg-gray-600 border border-gray-700">
                                <% } else { %>
                                <img src="/wkt/back/yt3<%- (new URL(video.author.thumbnails[0].url)).pathname %>" alt="<%= video.author.name %>" class="w-9 h-9 rounded-full object-cover bg-gray-600 border border-gray-700">
                                <% } %>
                            </a>
                            <% } %>
                            <div class="flex-1 min-w-0">
                                <a href="/wkt/watch/<%= video.id %>" target="_top">
                                    <p class="text-white font-bold text-sm leading-snug line-clamp-2 mb-1 hover:text-blue-400 transition"><%= video.title ? (video.title.text || video.title.toString()) : 'タイトル不明' %></p>
                                </a>
                                <a href="<%= (video.author?.id && video.author.id !== 'N/A') ? '/wkt/c/' + video.author.id : '/wkt/watch/' + video.id %>" class="text-gray-400 text-xs hover:text-white transition mb-0.5 block truncate" target="_top"><%= video.author?.name || '' %></a>
                                <p class="text-gray-500 text-xs"><%= video.view_count?.text || '' %><% if (video.published?.text) { %> • <%= video.published.text %><% } %></p>
                            </div>
                        </div>
                    </div>
                  <% } else if (video.type && video.type.endsWith("Playlist")) { %>
                  <%# チャンネルカードと同じ色(bg-gray-600)。サムネ・バッジ・文字の並びは動画カードに合わせてある。
                      文字色は、背景(gray-600)の上で読みやすい明るさ(コントラスト比 5 以上)にしている %>
                  <% const plThumbId = video?.endpoint?.payload?.videoId || video.first_videos?.[0]?.id; %>
                  <% const plAuthorLink = video.author?.id ? '/wkt/c/' + video.author.id : '/wkt/p/' + video.id; %>
                  <div class="result-item bg-gray-600 p-4 rounded">
                    <a href="/wkt/p/<%= video.id %>" class="block relative group" target="_top">
                      <% if (plThumbId) { %>
                      <img loading="lazy" src="/wkt/back/vi/<%= plThumbId %>/mqdefault.jpg" alt="<%= video.title?.text || '' %>" class="w-full h-auto rounded aspect-video object-cover">
                      <% } else { %>
                      <div class="w-full aspect-video rounded bg-gray-700"></div>
                      <% } %>
                      <span class="absolute bottom-1 right-1 bg-black bg-opacity-80 text-white text-xs px-1.5 py-0.5 rounded font-medium">プレイリスト<% if (video.video_count?.text) { %> • <%= video.video_count.text %>本<% } %></span>
                      <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-10 transition rounded"></div>
                    </a>
                    <div class="mt-3 flex items-start gap-3">
                      <a href="/wkt/p/<%= video.id %>" class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full border border-gray-500 bg-gray-700 text-gray-200" aria-label="プレイリストを開く" target="_top">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M4 10h12v2H4zm0-4h12v2H4zm0 8h8v2H4zm10 0v6l5-3z"/></svg>
                      </a>
                      <div class="flex-1 min-w-0">
                        <a href="/wkt/p/<%= video.id %>" target="_top">
                          <p class="text-white font-bold text-base leading-snug line-clamp-2 mb-1 hover:underline"><%= video.title?.text || '' %></p>
                        </a>
                        <% if (video.author?.name) { %>
                        <a href="<%= plAuthorLink %>" target="_top" class="block truncate text-sm text-gray-200 hover:underline"><%= video.author.name %></a>
                        <% } %>
                        <p class="text-xs text-gray-300">プレイリスト<% if (video.video_count?.text) { %> • <%= video.video_count.text %>本の動画<% } %></p>
                      </div>
                    </div>
                  </div>
                  <% } else if (video.type && video.type.endsWith("Channel")) { %>
                    <div class="result-item bg-gray-600 p-4 rounded">
                      <a href="/wkt/c/<%= video.author?.id || video.id %>" target="_top">
                        <% if (video.author?.thumbnails?.[0]?.url) { %>
                          <img src="<%= video.author.thumbnails[0].url %>" alt="<%= video.author?.name || 'チャンネル' %>" class="w-full h-auto rounded">
                        <% } %>
                      </a>
                        <div class="mt-2">
                            <p class="text-lg font-bold"><a href="/wkt/c/<%= video.author?.id || video.id %>" target="_top" class="hover:underline"><%= video.author?.name || '不明なチャンネル' %></a></p>
                            <p class="text-sm text-gray-400"><%= video.description_snippet?.text || '' %></p>
                            <p class="text-xs text-gray-500"><%= video.subscriber_count?.text || '' %><% if (video.videos?.text || video.video_count?.text) { %> • <%= video.videos?.text || video.video_count?.text %><% } %></p>
                        </div>
                    </div>
                  <% } %>
                <% }); %>
            <% } else { %>
                <div class="col-span-full text-center py-8">
                    <p class="text-gray-400">検索結果を取得できませんでした。</p>
                </div>
            <% } %>
        </div>
        
        <% if (page < 10) { %>
        <div class="flex justify-center mt-10 mb-6">
            <a class="px-6 py-3 bg-blue-600 text-white text-lg font-semibold rounded-full shadow-md hover:bg-blue-700 transition"
               href="/wkt/back/search?q=<%= encodeURIComponent(query) %>&p=<%= page+1 %>">
              もっと読み込む
            </a>
        </div>
        <% } %>
    </div>
<script>
window.addEventListener("load", function() {
  const query = '<%= query %>';
  if (query) {
      updateSearchHistory(query);
  }
});
  
function updateSearchHistory(query) {
    let history = JSON.parse(localStorage.getItem('searchHistory')) || [];
    history = history.filter(item => item !== query);
    history.unshift(query);
    if (history.length > 16) {
        history = history.slice(0, 16);
   }
   localStorage.setItem('searchHistory', JSON.stringify(history));
}
</script>
</body>
</html>
