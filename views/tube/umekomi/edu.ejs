<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= videoInfo.title %></title>
    <link rel="stylesheet" href="/css/page.css">
    <script src="/js/tailwindcss.js"></script>
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
    <script src="https://code.jquery.com/jquery-3.5.1.js"></script>
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>
    <script src="/js/tube.js"></script>
    <script src="/js/watch.js"></script>
    <link rel="apple-touch-icon" href="/wkt/back/vi/<%= videoId %>/maxresdefault.jpg">
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const isMobile = window.matchMedia("(max-width: 768px)").matches;

            if (isMobile || localStorage.getItem("sidebarHidden") === "true") {
                document.getElementById("sidebar").classList.add("hidden");
                document.getElementById("videoContainer").classList.add("full");
                document.getElementById("expandSidebar").classList.add("visible");
                document.getElementById("related-sidenone").classList.add("hidden");
            }
        });
    </script>
    <style>
        .iframe-container {
            position: relative;
            width: 100%;
            aspect-ratio: 16 / 9;
        }

        .iframe-container iframe {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
        }
        .main-container {
            display: flex;
            gap: 1rem;
            align-items: flex-start;
            transition: width 0.2s ease-in-out;
        }
        .video-container {
            flex: 1 1 0;
            min-width: 0;
            width: auto;
            transition: width 0.2s ease-in-out;
        }
        .video-container.full {
            width: 100%;
        }
        .sidebar {
            flex: 0 0 18rem;
            width: 18rem;
            transition: transform 0.2s ease-in-out;
        }
        .sidebar.hidden {
            transform: translateX(100%);
        }
        .related-sidenone {
            display: none;
        }
        .related-sidenone.hidden {
            display: block;
        }
        .expand-sidebar-btn {
            position: fixed;
            bottom: 20px;
            right: 10px;
            background: #444;
            color: white;
            padding: 10px 15px;
            border-radius: 5px;
            cursor: pointer;
            display: none;
        }
        .expand-sidebar-btn.visible {
            display: block;
        }
        .toolbar {
            position: fixed;
            top: 0;
            right: -50%;
            width: 50%;
            background: rgba(51, 51, 51, 0.95);
            transition: right 0.2s;
            padding: 20px;
            z-index: 10;
        }
        .toolbar.open { right: 0; }
        .toggle-btn { cursor: pointer; padding: 10px; background: #444; color: white; border: none; border-radius: 5px; }
        .checkbox-container { display: flex; align-items: center; }
        .controlPanel {
            display: none;
        }
        .controlPanel.open { display: block; }
        /* 全タブを同じ場所に重ねる → パネルの高さは一番高いタブに揃う (スクロールはしない) */
        .controlPanel .tab-stack { display: grid; grid-template-columns: minmax(0, 1fr); }
        .controlPanel .tab-stack > .tab-content {
            display: block;
            grid-area: 1 / 1;
            visibility: hidden;
        }
        .controlPanel .tab-stack > .tab-content.active { visibility: visible; }
        .tab-button.active {
            background-color: #4a5568;
            color: #fff;
        }
        .tab-content {
            display: none;
        }
        .tab-content.active {
            display: block;
        }
        .loading-indicator {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            display: none;
            z-index: 10;
        }
        .loading-indicator img {
            width: 75px;
            height: 75px;
        }
        .mobile-action-box {
            display: none;
            margin-top: 1rem;
        }
        /* サイドバー非表示時（.full クラスが付与されている状態）にボタンを表示 */
        .video-container.full .mobile-action-box {
            display: block;
        }
    </style>
</head>
<body class="bg-gray-900 text-white">
    <script data-tool>wktHeader()</script>

    <div class="toolbar w-1/2 ml-4" id="toolbar">
        <button id="closeToolbar" class="toggle-btn w-2/3 bg-gray-700 py-2 hover:text-white p-2 rounded mb-2 absolute top-4 right-4">閉じる</button>
        <nav class="mt-12">
            <button onclick="window.open('/wkt/back/vi/<%= videoId %>/maxresdefault.jpg', '_blank');" class="w-full bg-gray-700 py-2 hover:text-white p-2 rounded mb-2">サムネをダウンロード</button>
            <button onclick="window.open('/other/xerox#/watch/<%= videoId %>', '_blank');" class="w-full bg-gray-700 py-2 hover:text-white p-2 rounded mb-2">XeroxYT-NTで視聴</button>
            <button onclick="window.open('/other/labo5#/watch?v=<%= videoId %>', '_blank');" class="w-full bg-gray-700 py-2 hover:text-white p-2 rounded mb-2">Re: LABO5で視聴</button>
            <button onclick="window.open('/other/player#?v=<%= videoId %>&playlist=<%= videoId %>', '_blank');" class="w-full bg-gray-700 py-2 hover:text-white p-2 rounded mb-2">YouTube 埋め込み再生ツールで視聴</button>
            <button onclick="window.open('/other/player#?v=<%= videoId %>&list=<%= videoInfo.channelId %>', '_blank');" class="w-full bg-gray-700 py-2 hover:text-white p-2 rounded mb-2">YouTube 埋め込み再生ツールでチャンネルの動画を視聴</button>
        </nav>
    </div>

    <div class="max-w-6xl mx-auto p-4 main-container" id="mainContainer">
        <div class="video-container" id="videoContainer">
            <div class="relative">
                <div class="iframe-container">
                    <iframe id="eduFrame" src="<%= videosrc %>" frameborder="0" allowfullscreen></iframe>
                </div>
                <div class="mobile-action-box">
                    <button
                        class="w-full bg-gray-700 py-2 rounded"
                        onclick="document.getElementById('controlPanel').classList.toggle('open')">
                        コントロール
                    </button>
                </div>
            </div>
            <div class="flex items-start mt-4 p-4 bg-gray-800 rounded gap-3">
                <div class="flex-1 min-w-0">
                    <% if (videoInfo.channels.length === 1) { %>
                        <div class="flex items-center gap-3">
                            <a href="/wkt/c/<%= videoInfo.channels[0].id %>" class="flex-shrink-0">
                                <img src="<%= videoInfo.channels[0].icon %>" alt="アイコン" class="w-12 h-12 rounded-full">
                            </a>
                            <div class="min-w-0">
                                <h2 class="text-lg font-bold"><a href="/wkt/c/<%= videoInfo.channels[0].id %>"><%= videoInfo.channels[0].name %></a></h2>
                                <p class="text-sm text-gray-400"><%= videoInfo.channels[0].subsc %></p>
                            </div>
                            <button class="wkt-ch-fav ml-auto flex-shrink-0 p-2 rounded-full bg-gray-500" aria-label="チャンネルをお気に入り" data-entry="<%= JSON.stringify({
                                type: 'channel',
                                channelId: String(videoInfo.channels[0].id ?? ''),
                                channelName: String(videoInfo.channels[0].name ?? ''),
                                channelIcon: String(videoInfo.channels[0].icon ?? ''),
                                subsc: String(videoInfo.channels[0].subsc ?? '')
                            }) %>">
                                <img src="https://wsrv.nl/?url=https://kotonohaworks.com/free-icons/wp-content/uploads/kkrn_icon_hoshi_4.png" alt="チャンネルをお気に入り" class="w-8 h-8">
                            </button>
                        </div>
                    <% } else { %>
                        <ul class="space-y-3">
                            <% videoInfo.channels.forEach(function(ch) { %>
                                <li class="flex items-center gap-3">
                                    <a href="<%= ch.id ? '/wkt/c/' + ch.id : '#' %>" class="flex-shrink-0">
                                        <% if (ch.icon) { %>
                                            <img src="<%= ch.icon %>" alt="<%= ch.name %>" class="w-12 h-12 rounded-full object-cover">
                                        <% } else { %>
                                            <div class="w-12 h-12 rounded-full bg-gray-600"></div>
                                        <% } %>
                                    </a>
                                    <div class="min-w-0">
                                        <% if (ch.id) { %>
                                            <h2 class="text-lg font-bold"><a href="/wkt/c/<%= ch.id %>"><%= ch.name %></a></h2>
                                        <% } else { %>
                                            <h2 class="text-lg font-bold"><%= ch.name %></h2>
                                        <% } %>
                                        <% if (ch.subsc) { %><p class="text-sm text-gray-400"><%= ch.subsc %></p><% } %>
                                    </div>
                                    <% if (ch.id) { %>
                                    <button class="wkt-ch-fav ml-auto flex-shrink-0 p-2 rounded-full bg-gray-500" aria-label="チャンネルをお気に入り" data-entry="<%= JSON.stringify({
                                        type: 'channel',
                                        channelId: String(ch.id ?? ''),
                                        channelName: String(ch.name ?? ''),
                                        channelIcon: String(ch.icon ?? ''),
                                        subsc: String(ch.subsc ?? '')
                                    }) %>">
                                        <img src="https://wsrv.nl/?url=https://kotonohaworks.com/free-icons/wp-content/uploads/kkrn_icon_hoshi_4.png" alt="チャンネルをお気に入り" class="w-8 h-8">
                                    </button>
                                    <% } %>
                                </li>
                            <% }); %>
                        </ul>
                    <% } %>
                </div>
            </div>

            <div class="mt-4 p-4 bg-gray-800 rounded">
                <div class="flex items-start justify-between gap-3">
                    <h1 class="text-xl sm:text-2xl font-bold leading-snug text-balance min-w-0 break-words"><%= videoInfo.title %></h1>
                    <button id="wktFavBtn" class="flex-shrink-0 p-2 rounded-full bg-gray-500" aria-label="お気に入り" data-entry="<%= JSON.stringify({
                        videoId: String(videoId),
                        channelId: String(videoInfo.channelId ?? ''),
                        channelName: String(videoInfo.channelName ?? ''),
                        videoTitle: String(videoInfo.title ?? ''),
                        channelIcon: String(videoInfo.channelIcon ?? ''),
                        viewCount: String(videoInfo.viewCount ?? ''),
                        published: String(videoInfo.published ?? '')
                    }) %>">
                        <img src="https://wsrv.nl/?url=https://kotonohaworks.com/free-icons/wp-content/uploads/kkrn_icon_hoshi_4.png" alt="お気に入り" class="w-8 h-8">
                    </button>
                </div>
                <%# 再生回数・高評価数・公開日のバッジ。値が空(取得できなかった)ものは出さない %>
                <% if (videoInfo.viewCount || videoInfo.likeCount || videoInfo.published) { %>
                <div class="mt-3 flex flex-wrap items-center gap-2 text-sm">
                    <% if (videoInfo.viewCount) { %>
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-gray-700 ring-1 ring-gray-600 px-3 py-1 text-gray-200"><svg class="w-4 h-4 flex-shrink-0 text-blue-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg><span class="sr-only">再生回数: </span><%= videoInfo.viewCount %></span>
                    <% } %>
                    <% if (videoInfo.likeCount) { %>
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-gray-700 ring-1 ring-gray-600 px-3 py-1 text-gray-200"><svg class="w-4 h-4 flex-shrink-0 text-pink-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5"/></svg><span class="sr-only">高評価: </span><%= videoInfo.likeCount %></span>
                    <% } %>
                    <% if (videoInfo.published) { %>
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-gray-700 ring-1 ring-gray-600 px-3 py-1 text-gray-200"><svg class="w-4 h-4 flex-shrink-0 text-emerald-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg><span class="sr-only">公開日: </span><%= videoInfo.published %></span>
                    <% } %>
                </div>
                <% } %>
                <%
                    // 概要欄: まず HTML として解釈されないようにエスケープし、そのあとで URL と改行だけをタグにする
                    const descEsc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
                    const descText = String(videoInfo.description || '').trim();
                    const descHtml = descEsc(descText)
                        .replace(/https?:\/\/(?:[A-Za-z0-9\-._~:\/?#\[\]@!$'()*+,;=%]|&amp;)+/g, (u) => {
                            const tail = (u.match(/[.,;:!?)\]]+$/) || [''])[0]; // 文末の句読点はリンクに含めない
                            const url = tail ? u.slice(0, -tail.length) : u;
                            return '<a href="' + url + '" target="_blank" rel="noopener noreferrer" class="!text-blue-400 hover:!text-blue-300 underline underline-offset-2 break-all">' + url + '</a>' + tail;
                        })
                        .replace(/\n/g, '<br>');
                    // ponytail: 「長い」かは文字数と改行数の目安だけで判定(本当の行数は画面幅次第)。長い時だけ4行に省略してボタンを出す
                    const descLong = descText.length > 240 || (descText.match(/\n/g) || []).length >= 4;
                -%>
                <% if (descText) { %>
                <div class="mt-4 pt-4 border-t border-gray-700">
                    <div id="videoDescription" class="text-sm sm:text-base leading-relaxed text-gray-300 break-words<%= descLong ? ' line-clamp-4' : '' %>"><%- descHtml %></div>
                    <% if (descLong) { %>
                    <button type="button" id="descToggle" class="mt-1 -ml-2 inline-flex items-center gap-1 min-h-[44px] rounded-md px-2 text-sm font-semibold text-blue-400 hover:text-blue-300 hover:bg-gray-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400" aria-expanded="false" aria-controls="videoDescription" onclick="toggleDescription(this)">
                        <span data-label>もっと見る</span>
                        <svg class="w-4 h-4 transition-transform motion-reduce:transition-none" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M19 9l-7 7-7-7"/></svg>
                    </button>
                    <% } %>
                </div>
                <% } %>
            </div>

            <div class="mt-4 p-4 bg-gray-800 rounded">
                <h3 class="text-lg font-bold">コメント</h3>
                <div class="mt-2 space-y-2">
                    <div id="commentError2" class="text-red-500 hidden"></div>
                    <div id="commentsList2" class="mt-2 space-y-2">
                        <p>コメントを取得中...</p>
                    </div>
                </div>

                <button id="retryButton" class="w-full bg-gray-700 py-2 rounded mt-2 hidden">再取得</button>
            </div>

            <div class="related-sidenone mt-4 p-4 bg-gray-800 rounded" id="related-sidenone">
                <h3 class="text-lg font-bold">関連動画</h3><br>
                <% if (videoInfo.watch_next_feed && videoInfo.watch_next_feed.length > 0) { %>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
                        <% videoInfo.watch_next_feed.forEach(video => { %>
                            <% if (video.type.endsWith("Video")) { %>
                                <div class="result-item bg-gray-800 p-4 rounded-lg shadow hover:bg-gray-700 transition duration-200">
                                    <a href="/wkt/watch/<%= video.id %>" class="block relative group">
                                        <img loading="lazy" src="/wkt/back/vi/<%= video.id %>/mqdefault.jpg" alt="<%= video.title?.text || '動画' %>" class="w-full h-auto rounded aspect-video object-cover">
                                        <% if (video.isLive) { %><span class="absolute bottom-1 right-1 bg-red-600 bg-opacity-90 text-white text-xs px-1.5 py-0.5 rounded font-medium">ライブ</span><% } else if (video.duration?.text) { %><span class="absolute bottom-1 right-1 bg-black bg-opacity-80 text-white text-xs px-1.5 py-0.5 rounded font-medium"><%= video.duration.text %></span><% } %>
                                        <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-10 transition rounded"></div>
                                    </a>
                                    <div class="mt-3 flex items-start space-x-3">
                                        <a href="<%= (video.author?.id && video.author.id !== 'N/A') ? '/wkt/c/' + video.author.id : '/wkt/watch/' + video.id %>" class="flex-shrink-0">
                                            <% if (video.author?.thumbnails?.length) { %>
                                                <% if (video.author.id === 'N/A') { %>
                                                    <img src="<%= video.author.thumbnails[0].url %>" alt="<%= video.author?.name || '' %>" class="w-9 h-9 rounded-full object-cover bg-gray-600 border border-gray-700">
                                                <% } else { %>
                                                    <img src="/wkt/back/yt3<%- (new URL(video.author.thumbnails[0].url)).pathname %>" alt="<%= video.author?.name || '' %>" class="w-9 h-9 rounded-full object-cover bg-gray-600 border border-gray-700">
                                                <% } %>
                                            <% } else { %>
                                                <div class="w-9 h-9 rounded-full bg-gray-600 border border-gray-700"></div>
                                            <% } %>
                                        </a>
                                        <div class="flex-1 min-w-0">
                                            <a href="/wkt/watch/<%= video.id %>">
                                                <p class="text-white font-bold text-sm leading-snug line-clamp-2 mb-1 hover:text-blue-400 transition"><%= video.title?.text || '' %></p>
                                            </a>
                                            <a href="<%= (video.author?.id && video.author.id !== 'N/A') ? '/wkt/c/' + video.author.id : '/wkt/watch/' + video.id %>" class="text-gray-400 text-xs hover:text-white transition mb-0.5 block truncate"><%= video.author?.name || '' %></a>
                                            <p class="text-gray-500 text-xs"><%= video.view_count?.text || "" %><% if (video.published?.text) { %> • <%= video.published.text %><% } %></p>
                                        </div>
                                    </div>
                                </div>
                            <% } else if (video.type.endsWith("Playlist")) { %>
                            <%# チャンネルカードと同じ色(bg-gray-600)。サムネ・バッジ・文字の並びは動画カードに合わせてある。
                                文字色は、背景(gray-600)の上で読みやすい明るさ(コントラスト比 5 以上)にしている %>
                            <% const plThumbId = video?.endpoint?.payload?.videoId || video.first_videos?.[0]?.id; %>
                            <% const plAuthorLink = video.author?.id ? '/wkt/c/' + video.author.id : '/wkt/p/' + video.id; %>
                            <div class="result-item bg-gray-600 p-4 rounded">
                              <a href="/wkt/p/<%= video.id %>" class="block relative group">
                                <% if (plThumbId) { %>
                                <img loading="lazy" src="/wkt/back/vi/<%= plThumbId %>/mqdefault.jpg" alt="<%= video.title?.text || '' %>" class="w-full h-auto rounded aspect-video object-cover">
                                <% } else { %>
                                <div class="w-full aspect-video rounded bg-gray-700"></div>
                                <% } %>
                                <span class="absolute bottom-1 right-1 bg-black bg-opacity-80 text-white text-xs px-1.5 py-0.5 rounded font-medium">プレイリスト<% if (video.video_count?.text) { %> • <%= video.video_count.text %>本<% } %></span>
                                <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-10 transition rounded"></div>
                              </a>
                              <div class="mt-3 flex items-start gap-3">
                                <a href="/wkt/p/<%= video.id %>" class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full border border-gray-500 bg-gray-700 text-gray-200" aria-label="プレイリストを開く">
                                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M4 10h12v2H4zm0-4h12v2H4zm0 8h8v2H4zm10 0v6l5-3z"/></svg>
                                </a>
                                <div class="flex-1 min-w-0">
                                  <a href="/wkt/p/<%= video.id %>">
                                    <p class="text-white font-bold text-base leading-snug line-clamp-2 mb-1 hover:underline"><%= video.title?.text || '' %></p>
                                  </a>
                                  <% if (video.author?.name) { %>
                                  <a href="<%= plAuthorLink %>" class="block truncate text-sm text-gray-200 hover:underline"><%= video.author.name %></a>
                                  <% } %>
                                  <p class="text-xs text-gray-300">プレイリスト<% if (video.video_count?.text) { %> • <%= video.video_count.text %>本の動画<% } %></p>
                                </div>
                              </div>
                            </div>
                            <% } else if (video.type.endsWith("Channel")) { %>
                                <%# search.ejs と同じチャンネルカード(アイコン画像だけは、直接アクセスがブロックされることがあるため、プロキシ経由) %>
                                <div class="result-item bg-gray-600 p-4 rounded">
                                  <a href="/wkt/c/<%= video.author.id %>">
                                    <% if (video.author?.thumbnails?.length) { %>
                                    <% let chThumb = video.author.thumbnails[0].url; try { chThumb = '/wkt/back/yt3' + (new URL(chThumb)).pathname; } catch (e) {} %>
                                    <img src="<%= chThumb %>" alt="<%= video.author.name %>" class="w-full h-auto rounded">
                                    <% } %>
                                  </a>
                                  <div class="mt-2">
                                    <p class="text-lg font-bold"><a href="/wkt/c/<%= video.author.id %>" class="hover:underline"><%= video.author.name %></a></p>
                                    <p class="text-sm text-gray-400"><%= video.description_snippet?.text %></p>
                                    <p class="text-xs text-gray-500"><%= video.subscriber_count?.text %> • <%= video.videos?.text || video.video_count?.text %></p>
                                  </div>
                                </div>
                            <% } %>
                        <% }); %>
                    </div>
                <% } %>
            </div>
        </div>

        <div id="controlPanel" class="controlPanel bg-gray-900 text-white p-6 rounded-lg shadow-lg w-96 fixed bottom-10 right-10 border border-gray-700 z-50">
            <button id="closeControlPanel" class="absolute top-2 right-2 text-gray-400 hover:text-white text-2xl">×</button>
            <div class="tab-header flex border-b border-gray-700 mb-4">
                <div id="tabControl" class="tab-button active px-4 py-2 cursor-pointer text-gray-400 hover:text-white rounded-t-lg" data-target="controlTab">コントロール</div>
                <div id="tabSettings" class="tab-button px-4 py-2 cursor-pointer text-gray-400 hover:text-white rounded-t-lg" data-target="settingsTab">設定</div>
            </div>
            <div class="tab-stack">
            <div id="controlTab" class="tab-content active">
                <h2 class="text-lg font-semibold mb-3">URLパラメーターの選択</h2>
                <p class="mb-4 text-gray-300">Educationの埋め込みに使うURLパラメーターを選べます。選ぶとページを読み込み直さずにすぐ切り替わります。再生できない時は別のものを試してみてください。（取得できなかったパラメーターは選べません）</p>
                <p class="mb-4 text-gray-300">現在のパラメーター: <span id="currentParamBadge" class="inline-flex items-center px-2 py-0.5 rounded-full bg-blue-500/20 text-blue-300 text-sm font-semibold"><%= (eduParams.find(function(p) { return p.id === currentParamId; }) || {}).name %><% if (currentParamId === 'edurl') { %>（<%= defaultParamName %>）<% } %></span></p>
                <div class="control-section mb-4">
                    <label class="block mb-2">パラメーターを選択:
                        <select id="eduParamSelect" class="w-full bg-gray-800 text-white p-2 rounded">
                            <% eduParams.forEach(function(p) { %>
                                <option value="<%= p.id %>"<%= p.id === currentParamId ? ' selected' : '' %><%= eduParamData[p.id] ? '' : ' disabled' %>><%= p.name %></option>
                            <% }); %>
                        </select>
                    </label>
                    <button id="eduParamReset" class="control-button w-full bg-gray-700 py-2 hover:text-white p-2 rounded mb-2">
                        パラメーターをリセット
                    </button>
                </div>
            </div>
            <div id="settingsTab" class="tab-content">
                <h2 class="text-lg font-semibold mb-3">再生方法の変更</h2>
                <p class="mb-4 text-gray-300">動画のデフォルトの再生方法を設定できます。埋め込みで見れるなら埋め込みで見た方が良いですよ。</p>
                <p class="mb-4 text-gray-300">現在の再生方法: <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-blue-500/20 text-blue-300 text-sm font-semibold">Education</span></p>
                <div class="control-section mb-4">
                    <div class="flex flex-col gap-1">
                        <label class="flex items-start gap-2 py-1 px-1.5 -mx-1.5 rounded-md cursor-pointer transition-colors has-[:checked]:bg-blue-500/10 has-[:checked]:ring-1 has-[:checked]:ring-blue-500">
                            <input type="radio" name="playbackMode" value="normal" class="mt-1 accent-blue-500">
                            <div>
                                <strong>通常</strong> - ストリームURLを用いて再生します。最初のデフォルト設定で、ほとんどの人が使用できます。
                            </div>
                        </label>
                        <label class="flex items-start gap-2 py-1 px-1.5 -mx-1.5 rounded-md cursor-pointer transition-colors has-[:checked]:bg-blue-500/10 has-[:checked]:ring-1 has-[:checked]:ring-blue-500">
                            <input type="radio" name="playbackMode" value="edu" class="mt-1 accent-blue-500" checked>
                            <div>
                                <strong>Education</strong> - YouTubeEducationを埋め込んで再生を行います。一部の人が使用できます。
                            </div>
                        </label>
                        <label class="flex items-start gap-2 py-1 px-1.5 -mx-1.5 rounded-md cursor-pointer transition-colors has-[:checked]:bg-blue-500/10 has-[:checked]:ring-1 has-[:checked]:ring-blue-500">
                            <input type="radio" name="playbackMode" value="nocookie" class="mt-1 accent-blue-500">
                            <div>
                                <strong>Nocookie</strong> - YouTube-Nocookieを埋め込んで再生を行います。こちらも一部の人が使用できます。
                                <a href="/wkt/yt/nocookie/<%= videoId %>" class="text-blue-500 underline" target="_blank">再生できるか確かめる</a>。
                            </div>
                        </label>
                    </div>
                </div>

                <button id="saveSettings" class="control-button w-full bg-gray-700 py-2 hover:text-white p-2 rounded mb-2">💾 設定を保存</button>
            </div>
            </div><!-- /tab-stack -->
        </div>

        <div class="sidebar w-1/4 ml-4" id="sidebar">
            <button id="hideSidebar" class="w-full bg-gray-700 py-2 rounded">▶ サイドバーを隠す</button>
            <button id="toggleControlPanel" class="mt-4 w-full bg-gray-700 py-2 rounded">コントロール</button>
            <%# サイドバーの検索バー。見た目はヘッダーの検索バー(tube.js)と同じ。結果は関連動画の代わりにサイドバー内へ出す (サイドバーを閉じている間は、サイドバームごと隠れる) %>
            <form id="umekomisearchForm" role="search" class="relative mt-4">
                <input type="text" name="q" id="searchInput" placeholder="検索" aria-label="動画を検索" enterkeyhint="search" autocomplete="off" class="w-full bg-gray-700 text-white" style="height:2.5rem;padding:0 5.25rem 0 1rem;border-radius:9999px">
                <button type="button" id="sidebarClearBtn" aria-label="検索欄を消す" class="absolute top-1/2 -translate-y-1/2 flex items-center justify-center h-6 w-6 rounded-full hover:bg-gray-400 text-white text-lg leading-none hidden" style="right:2.75rem">×</button>
                <button type="submit" class="wkt-search-btn" aria-label="検索"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg></button>
            </form>
            <div id="searchResults" class="mt-4 hidden"></div>
            <div class="mt-4" id="sidebarRelated">
                <% if (videoInfo.watch_next_feed?.length) { %>
                    <% videoInfo.watch_next_feed.forEach(video => { %>
                        <div class="mt-2 space-y-4">
                            <% if (!video) return; %>
                            <% if (video.type.endsWith("Video")) { %>
                                <div class="result-item bg-gray-800 p-4 rounded-lg shadow hover:bg-gray-700 transition duration-200">
                                    <a href="/wkt/watch/<%= video.id %>" class="block relative group">
                                        <img loading="lazy" src="/wkt/back/vi/<%= video.id %>/mqdefault.jpg" alt="<%= video.title?.text || '動画' %>" class="w-full h-auto rounded aspect-video object-cover">
                                        <% if (video.isLive) { %><span class="absolute bottom-1 right-1 bg-red-600 bg-opacity-90 text-white text-xs px-1.5 py-0.5 rounded font-medium">ライブ</span><% } else if (video.duration?.text) { %>
                                            <span class="absolute bottom-1 right-1 bg-black bg-opacity-80 text-white text-xs px-1.5 py-0.5 rounded font-medium"><%= video.duration.text %></span>
                                        <% } %>
                                        <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-10 transition rounded"></div>
                                    </a>
                                    <div class="mt-3 flex items-start space-x-3">
                                        <a href="<%= (video.author?.id && video.author.id !== 'N/A') ? '/wkt/c/' + video.author.id : '/wkt/watch/' + video.id %>" class="flex-shrink-0">
                                            <% if (video.author?.thumbnails?.length) { %>
                                                <% if (video.author.id === 'N/A') { %>
                                                    <img src="<%= video.author.thumbnails[0].url %>" alt="<%= video.author?.name || '' %>" class="w-9 h-9 rounded-full object-cover bg-gray-600 border border-gray-700">
                                                <% } else { %>
                                                    <img src="/wkt/back/yt3<%- (new URL(video.author.thumbnails[0].url)).pathname %>" alt="<%= video.author?.name || '' %>" class="w-9 h-9 rounded-full object-cover bg-gray-600 border border-gray-700">
                                                <% } %>
                                            <% } else { %>
                                                <div class="w-9 h-9 rounded-full bg-gray-600 border border-gray-700"></div>
                                            <% } %>
                                        </a>
                                        <div class="flex-1 min-w-0">
                                            <a href="/wkt/watch/<%= video.id %>">
                                                <p class="text-white font-bold text-sm leading-snug line-clamp-2 mb-1 hover:text-blue-400 transition"><%= video.title?.text || '' %></p>
                                            </a>
                                            <a href="<%= (video.author?.id && video.author.id !== 'N/A') ? '/wkt/c/' + video.author.id : '/wkt/watch/' + video.id %>" class="text-gray-400 text-xs hover:text-white transition mb-0.5 block truncate"><%= video.author?.name || '' %></a>
                                            <p class="text-gray-500 text-xs"><%= video.view_count?.text || "" %><% if (video.published?.text) { %> • <%= video.published.text %><% } %></p>
                                        </div>
                                    </div>
                                </div>
                            <% } else if (video.type.endsWith("Playlist")) { %>
                                <%# search.ejs と同じ再生リストカード %>
                                <% const plThumbId = video?.endpoint?.payload?.videoId || video.first_videos?.[0]?.id; %>
                                <% const plAuthorLink = video.author?.id ? '/wkt/c/' + video.author.id : '/wkt/p/' + video.id; %>
                                <div class="result-item bg-gray-600 p-4 rounded">
                                  <a href="/wkt/p/<%= video.id %>" class="block relative group">
                                    <% if (plThumbId) { %>
                                    <img loading="lazy" src="/wkt/back/vi/<%= plThumbId %>/mqdefault.jpg" alt="<%= video.title?.text || '' %>" class="w-full h-auto rounded aspect-video object-cover">
                                    <% } else { %>
                                    <div class="w-full aspect-video rounded bg-gray-700"></div>
                                    <% } %>
                                    <span class="absolute bottom-1 right-1 bg-black bg-opacity-80 text-white text-xs px-1.5 py-0.5 rounded font-medium">プレイリスト<% if (video.video_count?.text) { %> • <%= video.video_count.text %>本<% } %></span>
                                    <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-10 transition rounded"></div>
                                  </a>
                                  <div class="mt-3 flex items-start gap-3">
                                    <a href="/wkt/p/<%= video.id %>" class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full border border-gray-500 bg-gray-700 text-gray-200" aria-label="プレイリストを開く">
                                      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M4 10h12v2H4zm0-4h12v2H4zm0 8h8v2H4zm10 0v6l5-3z"/></svg>
                                    </a>
                                    <div class="flex-1 min-w-0">
                                      <a href="/wkt/p/<%= video.id %>">
                                        <p class="text-white font-bold text-base leading-snug line-clamp-2 mb-1 hover:underline"><%= video.title?.text || '' %></p>
                                      </a>
                                      <% if (video.author?.name) { %>
                                      <a href="<%= plAuthorLink %>" class="block truncate text-sm text-gray-200 hover:underline"><%= video.author.name %></a>
                                      <% } %>
                                      <p class="text-xs text-gray-300">プレイリスト<% if (video.video_count?.text) { %> • <%= video.video_count.text %>本の動画<% } %></p>
                                    </div>
                                  </div>
                                </div>
                            <% } else if (video.type.endsWith("Channel")) { %>
                                <%# search.ejs と同じチャンネルカード(アイコン画像だけは、直接アクセスがブロックされることがあるため、プロキシ経由) %>
                                <div class="result-item bg-gray-600 p-4 rounded">
                                  <a href="/wkt/c/<%= video.author.id %>">
                                    <% if (video.author?.thumbnails?.length) { %>
                                    <% let chThumb = video.author.thumbnails[0].url; try { chThumb = '/wkt/back/yt3' + (new URL(chThumb)).pathname; } catch (e) {} %>
                                    <img src="<%= chThumb %>" alt="<%= video.author.name %>" class="w-full h-auto rounded">
                                    <% } %>
                                  </a>
                                  <div class="mt-2">
                                    <p class="text-lg font-bold"><a href="/wkt/c/<%= video.author.id %>" class="hover:underline"><%= video.author.name %></a></p>
                                    <p class="text-sm text-gray-400"><%= video.description_snippet?.text %></p>
                                    <p class="text-xs text-gray-500"><%= video.subscriber_count?.text %> • <%= video.videos?.text || video.video_count?.text %></p>
                                  </div>
                                </div>
                            <% } %>
                        </div>
                    <% }); %>
                <% } %>
            </div>
        </div>
    </div>

    <button id="expandSidebar" class="expand-sidebar-btn">◀ サイドバーを開く</button>

    <script>
        // コメント
        const commentContainers = [document.getElementById("commentsList2")];
        const errorContainers = [document.getElementById("commentError2")];
        const retryButton = document.getElementById("retryButton");

        async function fetchComments() {
            commentContainers.forEach(container => container.innerHTML = "<p>コメントを取得中...</p>");
            errorContainers.forEach(error => error.style.display = "none");
            retryButton.style.display = "none";

            try {
                const response = await fetch("/wkt/back/comment/<%= videoId %>");
                if (!response.ok) throw new Error("サーバーエラー");

                const responseText = await response.text();
                commentContainers.forEach(container => container.innerHTML = responseText);
            } catch (error) {
                console.error("エラー:", error);
                showerrorMessage("コメントの取得に失敗しました");
                errorContainers.forEach(errorContainer => {
                    errorContainer.textContent = "コメントの取得に失敗しました: " + error.message;
                    errorContainer.style.display = "block";
                });
                retryButton.style.display = "block";
            }
        }

        document.getElementById("retryButton").addEventListener("click", fetchComments);
        fetchComments();

        //けんさく (サイドバーの検索バー。結果は関連動画の代わりにサイドバー内へ出す。空にして送信すると関連動画に戻る)
        (function () {
            const form = document.getElementById('umekomisearchForm');
            const input = document.getElementById('searchInput');
            const related = document.getElementById('sidebarRelated');
            const results = document.getElementById('searchResults');
            const clear = document.getElementById('sidebarClearBtn');

            // ×ボタン: ヘッダーの検索バーと同じ (入力があるときだけ出して、押すと空にして入力欄に戻る)
            const sync = () => { clear.style.display = input.value ? 'block' : 'none'; };
            input.addEventListener('input', sync);
            clear.addEventListener('click', () => { input.value = ''; input.focus(); sync(); });
            sync();

            function showRelated() {
                results.classList.add('hidden');
                results.replaceChildren();
                related.classList.remove('hidden');
            }

            form.addEventListener('submit', function (event) {
                event.preventDefault();
                const q = input.value.trim();
                if (!q) { showRelated(); return; }
                showMessage("検索結果を取得します☑️");

                const back = document.createElement('button');
                back.type = 'button';
                back.className = 'w-full bg-gray-700 py-2 rounded mb-2';
                back.textContent = '← 関連動画に戻る';
                back.addEventListener('click', showRelated);

                const frame = document.createElement('iframe');
                frame.src = '/wkt/back/search?q=' + encodeURIComponent(q);
                frame.title = '検索結果';
                frame.allowFullscreen = true;
                frame.className = 'w-full border-0';
                frame.style.height = '100vh';

                results.replaceChildren(back, frame);
                related.classList.add('hidden');
                results.classList.remove('hidden');
            });
        })();

        // サイドバー
        function updateSidebarState(hidden) {
            localStorage.setItem("sidebarHidden", hidden);
        }

        document.getElementById("hideSidebar").addEventListener("click", function() {
            document.getElementById("sidebar").classList.add("hidden");
            document.getElementById("videoContainer").classList.add("full");
            document.getElementById("expandSidebar").classList.add("visible");
            document.getElementById("related-sidenone").classList.add("hidden");
            updateSidebarState(true);
        });

        document.getElementById("expandSidebar").addEventListener("click", function() {
            document.getElementById("sidebar").classList.remove("hidden");
            document.getElementById("videoContainer").classList.remove("full");
            this.classList.remove("visible");
            document.getElementById("related-sidenone").classList.remove("hidden");
            updateSidebarState(false);
        });

        // コントロール
        $(document).ready(function() {
            $('#toggleControlPanel').click(() => $('#controlPanel').toggleClass('open'));
            $('#closeControlPanel').click(() => $('#controlPanel').removeClass('open'));

            // タブ切り替え
            $('.tab-button').click(function() {
                $('.tab-button').removeClass('active');
                $(this).addClass('active');
                $('.tab-content').removeClass('active');
                $('#' + $(this).data('target')).addClass('active');
            });

            // URLパラメーターの変更（ページは読み込み直さず、iframeのsrcだけ差し替える）
            // 全パラメーターの値はサーバーがページに埋め込んでいるので、切り替え時の通信は不要
            // （値の中の「<」は \u003c に置き換えて、スクリプトが途中で閉じてしまわないようにしている）
            const eduParamData = <%- JSON.stringify(eduParamData).replace(/</g, '\\u003c').replace(/\u2028/g, '\\u2028').replace(/\u2029/g, '\\u2029') %>;
            const defaultParamName = <%- JSON.stringify(defaultParamName) %>;
            let currentParamId = <%- JSON.stringify(currentParamId) %>;

            $('#eduParamSelect').change(function() {
                const id = $(this).val();
                if (id === currentParamId) return;
                const name = $(this).find(':selected').text().trim();
                const param = eduParamData[id];

                $('#controlPanel').removeClass('open');
                if (!param) {
                    $(this).val(currentParamId); // 値が無い時は元の選択に戻す
                    showerrorMessage(`${name}のパラメーターを取得できていません`);
                    return;
                }
                document.getElementById('eduFrame').src =
                    `https://www.youtubeeducation.com/embed/${videoId}${param}&playlist=${videoId}`;
                currentParamId = id;
                document.cookie = `eduParam=${encodeURIComponent(id)}; path=/; max-age=31536000`;
                $('#currentParamBadge').text(id === 'edurl' ? `${name}（${defaultParamName}）` : name);
                showMessage(`URLパラメーターを${name}に変更しました☑️`);
            });

            // パラメーターをリセット (Default に戻す)
            $('#eduParamReset').click(function() {
                $('#eduParamSelect').val('edurl').trigger('change');
            });

            $('#saveSettings').click(function() {
                $('#controlPanel').toggleClass('open');
                const mode = $('input[name="playbackMode"]:checked').val();
                document.cookie = `playbackMode=${mode}; path=/; max-age=31536000`;
                showMessage(`再生方法を${mode}に変更します☑️`);
                window.location.href = `/wkt/redirect/mode/<%= videoId %>?mode=${mode}`;
            });
        });

        // ツールバー
        $('#toggleToolbar').click(() => $('#toolbar').addClass('open'));
        $('#closeToolbar').click(() => $('#toolbar').removeClass('open'));

        const videoId = "<%= videoId %>";
        // 概要
        function toggleDescription(button) {
            const description = document.getElementById('videoDescription');
            const expanded = !description.classList.toggle('line-clamp-4'); // 4行に省略している間は false
            button.setAttribute('aria-expanded', String(expanded));
            button.querySelector('[data-label]').textContent = expanded ? '折りたたむ' : 'もっと見る';
            button.querySelector('svg').style.transform = expanded ? 'rotate(180deg)' : '';
        }

        // ページ読み込み
        window.addEventListener("load", function() {
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('tu') === 'true') {
                showMessage("再生方法をEducationに変更しました☑️");
            }
        });

        function showMessage(text) {
            const alertMessage = document.createElement('div');
            alertMessage.classList.add(
                'fixed', 'top-4', 'right-4', 'bg-gradient-to-r',
                'from-gray-800', 'to-gray-600', 'text-white',
                'p-5', 'rounded-lg', 'shadow-xl', 'opacity-90',
                'z-50', 'transform', 'scale-100', 'transition-all',
                'border-2', 'border-indigo-500', 'cursor-pointer'
            );
            alertMessage.style.transition = 'transform 0.3s ease, opacity 0.3s ease';
            alertMessage.innerHTML = `
                <div class="flex items-center justify-between space-x-4">
                    <span class="font-semibold">ℹ︎ ${text}</span>
                    <button class="text-white hover:text-gray-300 focus:outline-none text-xl font-bold" aria-label="閉じる">&times;</button>
                </div>
            `;
            document.body.appendChild(alertMessage);
            const closeButton = alertMessage.querySelector('button');
            const autoRemoveTimer = setTimeout(() => {
                hideMessage(alertMessage);
            }, 3500);
            closeButton.addEventListener('click', () => {
                clearTimeout(autoRemoveTimer);
                hideMessage(alertMessage);
            });
            let startX = null;
            let currentX = 0;
            let moved = false;
            alertMessage.addEventListener('touchstart', (e) => {
                startX = e.touches[0].clientX;
                moved = false;
                alertMessage.style.transition = 'none';
            });
            alertMessage.addEventListener('touchmove', (e) => {
                if (startX === null) return;
                const touch = e.touches[0];
                const deltaX = touch.clientX - startX;
                if (Math.abs(deltaX) > 5) moved = true;
                currentX = deltaX;
                alertMessage.style.transform = `translateX(${deltaX}px) scale(1)`;
            });
            alertMessage.addEventListener('touchend', () => {
                alertMessage.style.transition = 'transform 0.3s ease, opacity 0.3s ease';
                if (moved && Math.abs(currentX) > 100) {
                    alertMessage.style.opacity = '0';
                    alertMessage.style.transform = `translateX(${currentX > 0 ? 500 : -500}px) scale(0.95)`;
                    setTimeout(() => alertMessage.remove(), 300);
                } else {
                    alertMessage.style.transform = 'translateX(0) scale(1)';
                }
                startX = null;
                currentX = 0;
                moved = false;
            });
        }

        function hideMessage(elem) {
            elem.style.transition = 'transform 0.3s ease, opacity 0.3s ease';
            elem.style.opacity = '0';
            elem.style.transform = 'translateX(100%) scale(1.1)';
            setTimeout(() => elem.remove(), 300);
        }

        function showerrorMessage(text) {
            const alertMessage = document.createElement('div');
            alertMessage.classList.add(
                'fixed', 'top-4', 'right-4', 'bg-gradient-to-r',
                'from-red-600', 'to-red-500', 'text-white',
                'p-5', 'rounded-lg', 'shadow-xl', 'opacity-90',
                'z-50', 'transform', 'scale-90', 'transition-transform',
                'border-2', 'border-red-500'
            );
            alertMessage.innerHTML = `
                <div class="flex items-center justify-between space-x-4">
                    <span class="font-semibold">⚠︎ ${text}</span>
                    <button class="text-white hover:text-gray-300 focus:outline-none text-xl font-bold" aria-label="閉じる">&times;</button>
                </div>
            `;
            document.body.appendChild(alertMessage);
            const closeButton = alertMessage.querySelector('button');
            const autoRemoveTimer = setTimeout(() => {
                hideMessage(alertMessage);
            }, 3500);
            closeButton.addEventListener('click', () => {
                clearTimeout(autoRemoveTimer);
                hideMessage(alertMessage);
            });
            let startX = null;
            let currentX = 0;
            let moved = false;
            alertMessage.addEventListener('touchstart', (e) => {
                startX = e.touches[0].clientX;
                moved = false;
                alertMessage.style.transition = 'none';
            });
            alertMessage.addEventListener('touchmove', (e) => {
                if (startX === null) return;
                const touch = e.touches[0];
                const deltaX = touch.clientX - startX;
                if (Math.abs(deltaX) > 5) moved = true;
                currentX = deltaX;
                alertMessage.style.transform = `translateX(${deltaX}px) scale(1)`;
            });
            alertMessage.addEventListener('touchend', () => {
                alertMessage.style.transition = 'transform 0.3s ease, opacity 0.3s ease';
                if (moved && Math.abs(currentX) > 100) {
                    alertMessage.style.opacity = '0';
                    alertMessage.style.transform = `translateX(${currentX > 0 ? 500 : -500}px) scale(0.95)`;
                    setTimeout(() => alertMessage.remove(), 300);
                } else {
                    alertMessage.style.transform = 'translateX(0) scale(1)';
                }
                startX = null;
                currentX = 0;
                moved = false;
            });
        }
    </script>
