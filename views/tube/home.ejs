<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ホーム</title>
    <link rel="stylesheet" href="/css/page.css">
    <script src="/js/tailwindcss.js"></script>
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
    <script src="https://code.jquery.com/jquery-3.5.1.js"></script>
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>
    <script src="/js/tube.js"></script>
    <style>
        /* アイコン(下の <symbol> を <use> で使う) */
        .ic {
            width: 1.25rem;
            height: 1.25rem;
            flex: none;
            fill: none;
            stroke: currentColor;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        /* ヘッダーのボタン(シークレット・再生方法) */
        .hdr-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            min-height: 2.75rem;
            padding: 0 0.75rem;
            border: 0;
            border-radius: 0.5rem;
            background: none;
            color: #e5e7eb;
            cursor: pointer;
            transition: background-color 0.2s ease;
        }
        .hdr-btn:hover { background-color: #374151; }
        .hdr-label { display: none; }
        @media (min-width: 640px) { .hdr-label { display: inline; } }

        /* ヒーロー(検索) */
        .hero-section {
            background-color: #2d3748;
            padding: 3rem 1rem 2.5rem;
        }
        .search-wrap {
            position: relative;
            width: min(92vw, 700px);
            margin: 0 auto;
        }
        .searchbox {
            display: block;
            width: 100%;
            box-sizing: border-box;
            padding: 0.75rem 3.5rem 0.75rem 1.25rem;
            font-size: 1.1rem;
            border-radius: 25px;
            border: none;
            background-color: rgba(255, 255, 255, 0.1);
            color: white;
            outline: none;
            transition: background-color 0.3s ease, box-shadow 0.3s ease;
        }
        .searchbox::placeholder { color: #a0aec0; }
        .searchbox:focus {
            background-color: rgba(255, 255, 255, 0.3);
            box-shadow: 0 0 8px rgba(255, 255, 255, 0.5);
        }
        .search-submit {
            position: absolute;
            right: 0.375rem;
            top: 50%;
            transform: translateY(-50%);
            display: flex;
            align-items: center;
            justify-content: center;
            width: 2.5rem;
            height: 2.5rem;
            border: 0;
            border-radius: 9999px;
            background-color: #3b82f6;
            color: #fff;
            cursor: pointer;
            transition: background-color 0.2s ease;
        }
        .search-submit:hover { background-color: #2563eb; }

        /* 検索の下のよく使うページ */
        .quick-links {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 0.5rem;
            margin-top: 1.25rem;
        }
        .quick-pill {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            min-height: 2.75rem;
            padding: 0 1rem;
            border-radius: 9999px;
            background-color: rgba(255, 255, 255, 0.1);
            color: #cbd5e0;
            font-size: 0.95rem;
            text-decoration: none;
            transition: background-color 0.2s ease, color 0.2s ease;
        }
        .quick-pill:hover { background-color: rgba(255, 255, 255, 0.2); color: #fff; }

        /* 初回のお知らせ(閉じるまで残る) */
        .home-note {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            width: min(92vw, 700px);
            margin: 1.25rem auto 0;
            padding: 0.25rem 0.25rem 0.25rem 1rem;
            border: 1px solid #4a5568;
            border-radius: 0.75rem;
            background-color: #1a202c;
            color: #cbd5e0;
            font-size: 0.9rem;
            text-align: left;
        }
        .home-note[hidden] { display: none; }
        .home-note button {
            flex: none;
            width: 2.75rem;
            height: 2.75rem;
            border: 0;
            border-radius: 0.5rem;
            background: none;
            color: #a0aec0;
            font-size: 1.5rem;
            line-height: 1;
            cursor: pointer;
        }
        .home-note button:hover { background-color: #2d3748; color: #fff; }

        /* カード */
        .home-h2 {
            margin-bottom: 1rem;
            padding-left: 0.75rem;
            border-left: 4px solid #3b82f6;
            color: #fff;
            font-size: 1.25rem;
            font-weight: 700;
        }
        .home-sec + .home-sec { margin-top: 2.5rem; }
        .home-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 0.75rem;
        }
        .app-card {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1rem;
            border: 2px solid #4a5568;
            border-radius: 20px;
            background-color: #1a202c;
            color: inherit;
            text-align: left;
            text-decoration: none;
            transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
        }
        .app-card:hover {
            transform: translateY(-4px);
            border-color: #3b82f6;
            box-shadow: 0 4px 10px rgba(255, 255, 255, 0.1);
        }
        .app-img {
            flex: none;
            width: 3.5rem;
            height: 3.5rem;
            object-fit: contain;
            border-radius: 10px;
        }
        .app-title { display: block; margin-bottom: 0.25rem; color: #fff; font-size: 1.1rem; font-weight: 600; }
        .app-desc { display: block; color: #cbd5e0; font-size: 0.875rem; line-height: 1.5; }
        @media (min-width: 640px) {
            .home-grid { grid-template-columns: repeat(3, 1fr); gap: 1rem; }
            .app-card { display: block; padding: 1.5rem 1rem; text-align: center; }
            .app-img { display: block; width: 5rem; height: 5rem; margin: 0 auto 0.75rem; }
        }

        .hdr-btn:focus-visible, .search-submit:focus-visible, .quick-pill:focus-visible,
        .app-card:focus-visible, .home-note button:focus-visible, .logo:focus-visible {
            outline: 2px solid #60a5fa;
            outline-offset: 2px;
        }
        @media (prefers-reduced-motion: reduce) {
            .app-card, .quick-pill, .searchbox, .hdr-btn { transition: none; }
            .app-card:hover { transform: none; }
        }

        footer {
            background-color: #2d3748;
            color: #cbd5e0;
            padding: 1rem;
            text-align: center;
            margin-top: 50px;
        }
        .logo img {
            height: 30px;
            width: auto;
        }
    </style>
</head>
<body class="bg-gray-900 font-sans">

    <!-- アイコン(線画)。使う所では <svg class="ic"><use href="#i-名前"/></svg> -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
        <symbol id="i-trend" viewBox="0 0 24 24"><path d="m22 7-8.5 8.5-5-5L2 17"/><path d="M16 7h6v6"/></symbol>
        <symbol id="i-star" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></symbol>
        <symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></symbol>
        <symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></symbol>
        <symbol id="i-eyeoff" viewBox="0 0 24 24"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><path d="M2 2l20 20"/></symbol>
        <symbol id="i-sliders" viewBox="0 0 24 24"><path d="M21 4h-7M10 4H3M21 12h-9M8 12H3M21 20h-5M12 20H3M14 2v4M8 10v4M16 18v4"/></symbol>
    </svg>

    <header class="wkt-hdr">
        <div class="wkt-hdr-left">
            <a href="/wkt" class="logo">
                <img src="https://count.getloli.com/@wkt-plus?name=wkt-plus&theme=original-new&padding=7&offset=0&align=top&scale=0.4&pixelated=1&darkmode=auto" alt="アクセスカウンター">
            </a>
        </div>
        <div class="wkt-hdr-right">
                <button type="button" id="secretModeBtn" class="hdr-btn" title="シークレットモード"></button>
                <button type="button" id="openSettings" class="hdr-btn" aria-haspopup="dialog" aria-label="再生方法" title="再生方法">
                    <svg class="ic" aria-hidden="true"><use href="#i-sliders"/></svg><span class="hdr-label">再生方法</span>
                </button>
        </div>
    </header>

    <section class="hero-section">
        <div class="text-center">
            <h1 class="text-4xl font-bold text-white mb-3">わかめtube Plus</h1>
            <p class="text-lg text-gray-400 mb-6">好きな動画を検索してみましょう！</p>
            <form action="/wkt/s" method="get" id="searchForm" class="search-wrap">
                <input type="text" name="q" id="searchbox" placeholder="キーワード、もしくはYouTubeのURLを入力..." class="searchbox" aria-label="動画を検索">
                <button type="submit" class="search-submit" aria-label="検索"><svg class="ic" aria-hidden="true"><use href="#i-search"/></svg></button>
            </form>
            <nav class="quick-links" aria-label="よく使うページ">
                <a href="/wkt/trend" class="quick-pill"><svg class="ic" aria-hidden="true"><use href="#i-trend"/></svg>トレンド</a>
                <a href="/wkt/cl/fav" class="quick-pill"><svg class="ic" aria-hidden="true"><use href="#i-star"/></svg>お気に入り</a>
                <a href="/wkt/cl/history" class="quick-pill"><svg class="ic" aria-hidden="true"><use href="#i-clock"/></svg>閲覧履歴</a>
            </nav>
            <div id="homeNote" class="home-note" role="status" hidden>
                <span id="homeNoteText"></span>
                <button type="button" id="homeNoteClose" aria-label="お知らせを閉じる">&times;</button>
            </div>
        </div>
    </section>

    <section class="py-10 px-4 bg-gray-800">
        <div class="max-w-3xl mx-auto">

            <div class="home-sec">
                <h2 class="home-h2">見る・探す</h2>
                <div class="home-grid">
                    <a href="/other" class="app-card">
                        <img class="app-img" src="https://t3.gstatic.com/faviconV2?client=SOCIAL&type=FAVICON&fallback_opts=TYPE,SIZE,URL&url=https://www.youtube.com/&size=256" alt="" width="56" height="56" loading="lazy">
                        <span>
                            <span class="app-title">YouTubeサイト集</span>
                            <span class="app-desc">他の方が作ったYouTubeサイトを搭載。</span>
                        </span>
                    </a>
                    <a href="/other/tv" class="app-card">
                        <img class="app-img" src="https://wsrv.nl/?url=https://kotonohaworks.com/free-icons/wp-content/uploads/kkrn_icon_tv_1.png" alt="" width="56" height="56" loading="lazy">
                        <span>
                            <span class="app-title">TV</span>
                            <span class="app-desc">世界中のテレビ局のニュース番組を視聴できます。</span>
                        </span>
                    </a>
                    <a href="/other/x" class="app-card">
                        <img class="app-img" src="https://t3.gstatic.com/faviconV2?client=SOCIAL&type=FAVICON&fallback_opts=TYPE,SIZE,URL&url=https://x.com/&size=256" alt="" width="56" height="56" loading="lazy">
                        <span>
                            <span class="app-title">X</span>
                            <span class="app-desc">Xの投稿を検索・閲覧できます。</span>
                        </span>
                    </a>
                </div>
            </div>

            <div class="home-sec">
                <h2 class="home-h2">ほかの機能</h2>
                <div class="home-grid">
                    <a href="/game" class="app-card">
                        <img class="app-img" src="https://wsrv.nl/?url=https://kotonohaworks.com/free-icons/wp-content/uploads/kkrn_icon_game_1.png" alt="" width="56" height="56" loading="lazy">
                        <span>
                            <span class="app-title">ゲーム</span>
                            <span class="app-desc">Webゲームをプレイ。</span>
                        </span>
                    </a>
                    <a href="/wakams" class="app-card">
                        <img class="app-img" src="https://t3.gstatic.com/faviconV2?client=SOCIAL&type=FAVICON&fallback_opts=TYPE,SIZE,URL&url=https://soundcloud.com/&size=256" alt="" width="56" height="56" loading="lazy">
                        <span>
                            <span class="app-title">音楽</span>
                            <span class="app-desc">音楽を聴くためのアプリ</span>
                        </span>
                    </a>
                    <a href="/tools" class="app-card">
                        <img class="app-img" src="https://wsrv.nl/?url=https://icooon-mono.com/i/icon_10173/icon_101730_256.png" alt="" width="56" height="56" loading="lazy">
                        <span>
                            <span class="app-title">プロキシ＆ツール</span>
                            <span class="app-desc">プロキシや便利ツールをまとめています。</span>
                        </span>
                    </a>
                </div>
            </div>

        </div>
    </section>

<div id="settingsBackdrop" class="fixed inset-0 z-40" style="background: rgba(0, 0, 0, 0.6);" hidden></div>
<div id="settingsPanel" role="dialog" aria-modal="true" aria-labelledby="settingsTitle" inert class="fixed top-0 left-0 w-full z-50 max-h-screen overflow-y-auto bg-white dark:bg-gray-900 shadow-lg p-6 -translate-y-full transition-transform duration-300 motion-reduce:transition-none">
    <div class="relative bg-gray-100 dark:bg-gray-800 text-gray-900 dark:text-white max-w-2xl mx-auto bg-white dark:bg-gray-900 p-6 rounded-lg shadow-md">
      <h2 id="settingsTitle" class="text-2xl font-bold mb-4">再生方法の設定</h2>
      <p class="mb-4 text-gray-700 dark:text-gray-300">再生方法を選択してください。詳しくは<a href="/blog/b/wkthelp" style="color: #60a5fa; text-decoration: underline; transition: color 0.3s ease;">ヘルプ</a>をみてね</p>

      <form id="settingsForm" class="space-y-4">
        <label class="block p-4 border rounded-lg cursor-pointer dark:border-gray-700">
          <input type="radio" name="playbackMode" value="normal" class="mr-2">
          <span class="font-semibold">通常</span>
          <p class="text-sm text-gray-600 dark:text-gray-400">通常の再生方法で、ストリームを取得して再生を行います。</p>
        </label>

        <label class="block p-4 border rounded-lg cursor-pointer dark:border-gray-700">
          <input type="radio" name="playbackMode" value="edu" class="mr-2">
          <span class="font-semibold">Education</span>
          <p class="text-sm text-gray-600 dark:text-gray-400">YouTubeEducationを埋め込んで再生を行います。</p>
        </label>

        <label class="block p-4 border rounded-lg cursor-pointer dark:border-gray-700">
          <input type="radio" name="playbackMode" value="nocookie" class="mr-2">
          <span class="font-semibold">Nocookie</span>
          <p class="text-sm text-gray-600 dark:text-gray-400">YouTube-Nocookieを埋め込んで再生を行います。</p>
        </label>

        <button type="button" id="saveButton" class="px-6 py-2 bg-blue-500 text-white rounded-md hover:bg-blue-600 dark:bg-blue-700 dark:hover:bg-blue-600 transition-colors">保存</button>
      </form>

      <button type="button" id="closeSettings" aria-label="閉じる" class="absolute top-4 right-4 text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white text-4xl font-bold w-12 h-12 flex items-center justify-center rounded-full hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors">
        ×
      </button>
    </div>
</div>

<footer>
    <p>
        ♪( ´▽｀)<br>現在のバージョン: <%= version %>
        <% if (isOutdated) { %>
            <span>(更新あり)</span>
        <% } else { %>
            <span>(最新版)</span>
        <% } %>
    </p>
</footer>

<script>
// ==========================================
// 検索ボックスの処理
// ==========================================
document.getElementById("searchForm").addEventListener("submit", function(event) {
    event.preventDefault();
    const query = document.getElementById("searchbox").value.trim();
    const ytRegex = /(?:https?:\/\/)?(?:www\.)?youtu(?:\.be\/|be\.com\/(?:watch\?v=|embed\/|v\/|shorts\/))([\w\-]+)/;
    const match = query.match(ytRegex);

    let targetUrl = '';
    if (match) {
        const videoId = match[1];
        showMessage(`YouTubeのURLとして処理されました☑️`);
        targetUrl = `/wkt/watch/${videoId}`;
    } else {
        // 通常の検索遷移先を生成
        targetUrl = `/wkt/s?q=${encodeURIComponent(query)}`;
    }

    // シークレットON かつ 通常のタブ（about:blankの中ではない）なら自動クローキング発動
    if (window === window.parent && localStorage.getItem('secretMode') === 'on') {
        const fullUrl = new URL(targetUrl, window.location.origin).href;
        if (typeof openUrlInAboutBlank === 'function') {
            openUrlInAboutBlank(fullUrl, true); // 遷移先をabout:blankで開き、元タブを隠す
        } else {
            window.location.href = targetUrl;
        }
    } else {
        // 通常遷移
        window.location.href = targetUrl;
    }
});

// ==========================================
// 初回のお知らせ(検索の下に出して、×で閉じるまで残す)
// ==========================================
window.addEventListener("load", function() {
    const hometut = localStorage.getItem('homec');
    const note = document.getElementById('homeNote');
    const show = (html) => {
        document.getElementById('homeNoteText').innerHTML = html;
        note.hidden = false;
    };
    if (!hometut) {
      show("ようこそ！もし何か知りたい場合<a href='/blog/b/wkthelp' style='color: #60a5fa;'>ヘルプページ</a>を見てみて下さい。");
      localStorage.setItem('homec', 'true');
    } else if(hometut === "true"){
      show("このサイトは誰でも作ることができます！詳しくは<a href='/blog/b/wkthelp' style='color: #60a5fa;'>わかめtube Plusを作ってみる</a>を見てみて下さい！");
      localStorage.setItem('homec', 'ok');
    }
    document.getElementById('homeNoteClose').addEventListener('click', () => { note.hidden = true; });
});

function showMessage(text) {
    const alertMessage = document.createElement('div');
    alertMessage.classList.add(
        'fixed', 'top-4', 'right-4', 'bg-gradient-to-r',
        'from-gray-800', 'to-gray-600', 'text-white',
        'p-5', 'rounded-lg', 'shadow-xl', 'opacity-90',
        'z-50', 'transform', 'scale-100', 'transition-all',
        'border-2', 'border-indigo-500', 'cursor-pointer'
    );
    alertMessage.style.transition = 'transform 0.3s ease, opacity 0.3s ease';
    alertMessage.innerHTML = `
        <div class="flex items-center justify-between space-x-4">
            <span class="font-semibold">ℹ︎ ${text}</span>
            <button class="text-white hover:text-gray-300 focus:outline-none text-xl font-bold" aria-label="閉じる">&times;</button>
        </div>
    `;
    document.body.appendChild(alertMessage);
    const closeButton = alertMessage.querySelector('button');
    const autoRemoveTimer = setTimeout(() => {
        hideMessage(alertMessage);
    }, 3500);
    closeButton.addEventListener('click', () => {
        clearTimeout(autoRemoveTimer);
        hideMessage(alertMessage);
    });
    let startX = null;
    let currentX = 0;
    let moved = false;
    alertMessage.addEventListener('touchstart', (e) => {
        startX = e.touches[0].clientX;
        moved = false;
        alertMessage.style.transition = 'none';
    });
    alertMessage.addEventListener('touchmove', (e) => {
        if (startX === null) return;
        const touch = e.touches[0];
        const deltaX = touch.clientX - startX;
        if (Math.abs(deltaX) > 5) moved = true;
        currentX = deltaX;
        alertMessage.style.transform = `translateX(${deltaX}px) scale(1)`;
    });
    alertMessage.addEventListener('touchend', () => {
        alertMessage.style.transition = 'transform 0.3s ease, opacity 0.3s ease';
        if (moved && Math.abs(currentX) > 100) {
            alertMessage.style.opacity = '0';
            alertMessage.style.transform = `translateX(${currentX > 0 ? 500 : -500}px) scale(0.95)`;
            setTimeout(() => alertMessage.remove(), 300);
        } else {
            alertMessage.style.transform = 'translateX(0) scale(1)';
        }
        startX = null;
        currentX = 0;
        moved = false;
    });
}
function hideMessage(elem) {
    elem.style.transition = 'transform 0.3s ease, opacity 0.3s ease';
    elem.style.opacity = '0';
    elem.style.transform = 'translateX(100%) scale(1.1)';
    setTimeout(() => elem.remove(), 300);
}

// ==========================================
// 設定パネル関連(背景の暗幕・Escで閉じる・閉じている間はTabで入れない)
// ==========================================
const settingsPanel = document.getElementById('settingsPanel');
const settingsBackdrop = document.getElementById('settingsBackdrop');
const openSettingsBtn = document.getElementById('openSettings');

function setSettingsPanel(open) {
    settingsPanel.classList.toggle('-translate-y-full', !open);
    settingsPanel.inert = !open;
    settingsBackdrop.hidden = !open;
    if (open) {
        (settingsPanel.querySelector('input:checked') || settingsPanel.querySelector('input')).focus();
    } else {
        openSettingsBtn.focus();
    }
}

openSettingsBtn.addEventListener('click', () => setSettingsPanel(true));
document.getElementById('closeSettings').addEventListener('click', () => setSettingsPanel(false));
settingsBackdrop.addEventListener('click', () => setSettingsPanel(false));
document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !settingsPanel.inert) setSettingsPanel(false);
});

document.getElementById('saveButton').addEventListener('click', () => {
    const mode = document.querySelector('input[name=playbackMode]:checked').value;
    document.cookie = `playbackMode=${mode}; path=/; max-age=31536000`;
    setSettingsPanel(false);
    showMessage(`再生方法を${mode}に変更しました☑️`);
});

window.addEventListener('DOMContentLoaded', () => {
    const cookies = document.cookie.split('; ').reduce((acc, cookie) => {
        const [key, value] = cookie.split('=');
        acc[key] = value;
        return acc;
    }, {});
    const playbackMode = cookies.playbackMode || 'normal';
    document.querySelector(`input[value="${playbackMode}"]`).checked = true;
});


// ==========================================
// シークレットモード（ON/OFF機能 & 自動発動）
// ==========================================

const secretModeBtn = document.getElementById('secretModeBtn');

// デフォルト状態を「オン」にする
if (localStorage.getItem('secretMode') === null) {
    localStorage.setItem('secretMode', 'on');
}

// ボタンの表示(アイコン・ON/OFF)を更新する関数
function updateSecretBtnDisplay() {
    const on = localStorage.getItem('secretMode') === 'on';
    secretModeBtn.innerHTML = '<svg class="ic" aria-hidden="true"><use href="#i-eyeoff"/></svg>'
        + '<span class="hdr-label">シークレット</span>'
        + (on
            ? '<span class="text-green-400 font-bold text-sm">ON</span>'
            : '<span class="text-gray-500 font-bold text-sm">OFF</span>');
    secretModeBtn.setAttribute('aria-label', 'シークレットモード ' + (on ? 'ON' : 'OFF'));
}
updateSecretBtnDisplay(); // ロード時に表示を合わせる

// ボタンを押した時の処理（ON/OFFの切り替え）
secretModeBtn.addEventListener('click', (e) => {
    e.preventDefault();
    const currentMode = localStorage.getItem('secretMode');

    if (currentMode === 'on') {
        // オフにしようとした時の警告
        if (confirm('シークレットモードをオフにすると履歴が残ってしまいますが、よろしいですか？')) {
            localStorage.setItem('secretMode', 'off');
            updateSecretBtnDisplay();
            showMessage('シークレットモードをOFFにしました。');
        }
    } else {
        // オンにする
        localStorage.setItem('secretMode', 'on');
        updateSecretBtnDisplay();
        showMessage('シークレットモードをONにしました。');
    }
});

// 【自動クローキングの発動】
// 通常のタブ（about:blankではない場所）にいる場合のみ、リンクのクリックを監視する
if (window === window.parent) {
    document.addEventListener('click', function(e) {
        const link = e.target.closest('a');

        // リンクが存在し、設定用のリンク(#)やJavaScript実行ではない場合
        if (link && link.href && !link.getAttribute('href').startsWith('#') && !link.href.startsWith('javascript:')) {

            // シークレットモードがONなら、遷移をキャンセルしてabout:blankで開き直す
            if (localStorage.getItem('secretMode') === 'on') {
                e.preventDefault();
                if (typeof openUrlInAboutBlank === 'function') {
                    openUrlInAboutBlank(link.href, true); // true = 元タブをGoogleへ
                } else {
                    window.location.href = link.href; // 万が一関数が読み込めていない時の保険
                }
            }
        }
    });
}

</script>
</body>
</html>
