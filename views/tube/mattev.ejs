<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/page.css">
    <script src="/js/tailwindcss.js"></script>
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
    <script src="https://code.jquery.com/jquery-3.5.1.js"></script>
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>
    <script src="/js/tube.js"></script>
    <title>エラー</title>
<style>
        .controlPanel {
            display: none;
        }
        .controlPanel.open { display: block; }
        .tab-button.active {
            background-color: #4a5568;
        }
        .tab-content {
            display: none;
        }
        .tab-content.active {
            display: block;
         }
        /* ツールパネル(動画ページと同じ。右から出る) */
        .toolbar {
            position: fixed;
            top: 0;
            right: -100%;
            width: min(100%, 28rem);
            box-sizing: border-box;
            background: rgba(51, 51, 51, 0.95);
            transition: right 0.2s;
            padding: 20px;
            z-index: 10;
        }
        .toolbar.open { right: 0; }
        /* 再生方法の設定ウィンドウ */
        .playback-modal {
            position: fixed;
            inset: 0;
            z-index: 1002;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
            background: rgba(0, 0, 0, 0.6);
        }
        .playback-modal[hidden] { display: none; }
        .playback-card {
            position: relative;
            width: min(100%, 28rem);
            max-height: 100%;
            overflow-y: auto;
        }
        @media (prefers-reduced-motion: reduce) { .toolbar { transition: none; } }
</style>
</head>
<body class="bg-gray-900 text-white">
    <script data-q="<%= typeof query !== 'undefined' ? query : '' %>" data-tool>wktHeader()</script>

    <div class="toolbar" id="toolbar">
        <button id="closeToolbar" type="button" class="w-2/3 bg-gray-700 py-2 hover:text-white p-2 rounded mb-2 absolute top-4 right-4 cursor-pointer">閉じる</button>
        <nav class="mt-12">
            <button type="button" onclick="window.open('/wkt/back/vi/<%= videoId %>/maxresdefault.jpg', '_blank');" class="w-full bg-gray-700 py-2 hover:text-white p-2 rounded mb-2">サムネをダウンロード</button>
            <button type="button" onclick="window.open('/other/xerox#/watch/<%= videoId %>', '_blank');" class="w-full bg-gray-700 py-2 hover:text-white p-2 rounded mb-2">XeroxYT-NTで視聴</button>
            <button type="button" onclick="window.open('/other/labo5#/watch?v=<%= videoId %>', '_blank');" class="w-full bg-gray-700 py-2 hover:text-white p-2 rounded mb-2">Re: LABO5で視聴</button>
            <button type="button" onclick="window.open('/other/player#?v=<%= videoId %>&playlist=<%= videoId %>', '_blank');" class="w-full bg-gray-700 py-2 hover:text-white p-2 rounded mb-2">YouTube 埋め込み再生ツールで視聴</button>
        </nav>
    </div>

    <div class="max-w-4xl mx-4 md:mx-auto p-6 bg-gray-800 rounded-lg shadow-lg my-8">
        <h1 class="text-3xl font-bold text-center mb-6">動画を取得できません</h1>
        <p class="text-center text-lg mb-6">エラー: <%= details %></p>
        <div class="flex w-full justify-center mb-6">
            <img src="/wkt/back/vi/<%= videoId %>/mqdefault.jpg" class="rounded-lg shadow-md max-w-full">
        </div>

        <div class="flex justify-center mb-6">
            <button id="openPlaybackSettings" type="button" aria-haspopup="dialog" class="inline-flex items-center gap-2 px-5 py-2 bg-gray-700 text-white rounded-lg hover:bg-gray-600 focus:outline-none focus:ring-2 focus:ring-blue-300">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 4h-7M10 4H3M21 12h-9M8 12H3M21 20h-5M12 20H3M14 2v4M8 10v4M16 18v4"/></svg>
                再生方法を変更
            </button>
        </div>
        
        <div class="text-center">
            <% if (typeof serverUrls !== 'undefined' && Array.isArray(serverUrls) && serverUrls.length > 0) { %>
                
                <% if (typeof details === 'string' && details.includes('Cannot read')) { %>
                    <p class="text-center text-lg mb-6">通常再生を選択中です</p>
                    <p class="text-center text-lg mb-6">YouTubeから動画情報をうまく取得できませんでした。<br>時間をおいて試してみて下さい。</p>
                <% } %>

                <p class="text-center text-lg mb-6">現在のサーバー: <strong><%= typeof baseUrl !== 'undefined' ? baseUrl.replace('https://', '').replace('.glitch.me', '') : '未設定' %></strong></p>
                <label for="serverSelect" class="text-xl">サーバーを変更:</label>
                <select id="serverSelect" class="mt-2 p-3 bg-gray-700 text-white rounded-lg border border-gray-600 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    <% serverUrls.forEach(server => { %>
                        <option value="<%= server.replace('https://', '').replace('.glitch.me', '') %>" class="bg-gray-800 hover:bg-gray-700" <%= typeof baseUrl !== 'undefined' && server === baseUrl ? 'selected' : '' %>>
                            <%= server.replace('https://', '').replace('.glitch.me', '') %>
                        </option>
                    <% }); %>
                </select>
                <button onclick="changeServer()" class="mt-4 px-6 py-3 bg-blue-500 text-white rounded-lg hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-300">変更</button>
                <br>
                <p class="text-center text-lg mb-6 mt-6">サーバーは上から順番に試して下さい。デフォルトでInvidiousを使っているので、無理だった場合はAceThinkerから試してみてね</p>
            <% } else { %>
                <p class="text-center text-lg mb-6">埋め込み再生を選択中です</p>
                <p class="text-center text-lg mb-6">YouTubeから動画情報をうまく取得できませんでした。<br>時間をおいて試してみて下さい。</p>
            <% } %>
        </div>
    </div>

    <div id="playbackModal" class="playback-modal" role="dialog" aria-modal="true" aria-labelledby="playbackTitle" hidden>
        <div class="playback-card bg-gray-900 text-white p-6 rounded-lg shadow-lg border border-gray-700">
            <button id="closePlayback" type="button" aria-label="閉じる" class="absolute top-2 right-2 text-gray-400 hover:text-white text-2xl">×</button>
            <h2 id="playbackTitle" class="text-lg font-semibold mb-3">再生方法の変更</h2>
            <p class="mb-4 text-gray-300">動画のデフォルトの再生方法を設定できます。埋め込みで見れるなら埋め込みで見た方が良いですよ。</p>
            <p class="mb-4 text-gray-300">現在の再生方法: <span id="currentMode" class="inline-flex items-center px-2 py-0.5 rounded-full bg-blue-500/20 text-blue-300 text-sm font-semibold">通常</span></p>
            <div class="mb-4">
                <div class="flex flex-col gap-1">
                    <label class="flex items-start gap-2 py-1 px-1.5 -mx-1.5 rounded-md cursor-pointer transition-colors has-[:checked]:bg-blue-500/10 has-[:checked]:ring-1 has-[:checked]:ring-blue-500">
                        <input type="radio" name="playbackMode" value="normal" class="mt-1 accent-blue-500" checked>
                        <div>
                            <strong>通常</strong> - ストリームURLを用いて再生します。最初のデフォルト設定で、ほとんどの人が使用できます。
                        </div>
                    </label>
                    <label class="flex items-start gap-2 py-1 px-1.5 -mx-1.5 rounded-md cursor-pointer transition-colors has-[:checked]:bg-blue-500/10 has-[:checked]:ring-1 has-[:checked]:ring-blue-500">
                        <input type="radio" name="playbackMode" value="edu" class="mt-1 accent-blue-500">
                        <div>
                            <strong>Education</strong> - YouTubeEducationを埋め込んで再生を行います。一部の人が使用できます。
                            <a href="/wkt/yt/edu/<%= videoId %>" class="text-blue-500 underline" target="_blank">再生できるか確かめる</a>。
                        </div>
                    </label>
                    <label class="flex items-start gap-2 py-1 px-1.5 -mx-1.5 rounded-md cursor-pointer transition-colors has-[:checked]:bg-blue-500/10 has-[:checked]:ring-1 has-[:checked]:ring-blue-500">
                        <input type="radio" name="playbackMode" value="nocookie" class="mt-1 accent-blue-500">
                        <div>
                            <strong>Nocookie</strong> - YouTube-Nocookieを埋め込んで再生を行います。こちらも一部の人が使用できます。
                            <a href="/wkt/yt/nocookie/<%= videoId %>" class="text-blue-500 underline" target="_blank">再生できるか確かめる</a>。
                        </div>
                    </label>
                </div>
            </div>
            <button id="saveSettings" type="button" class="w-full bg-gray-700 py-2 hover:text-white p-2 rounded mb-2">💾 設定を保存</button>
        </div>
    </div>

    <script>
function changeServer() {
    const serverSelect = document.getElementById('serverSelect');
    if (!serverSelect) return;
    const server = serverSelect.value;
    showMessage(`サーバーを${server}に変更します☑️`)
    window.location.href = `/wkt/watch/<%= videoId %>?server=${server}`;
}
function showMessage(text) {
    const alertMessage = document.createElement('div');
    alertMessage.classList.add(
        'fixed', 'top-4', 'right-4', 'bg-gradient-to-r', 
        'from-gray-800', 'to-gray-600', 'text-white', 
        'p-5', 'rounded-lg', 'shadow-xl', 'opacity-90', 
        'z-50', 'transform', 'scale-90', 'transition-transform', 
        'border-2', 'border-indigo-500'
    );
    alertMessage.innerHTML = `
        <span class="font-semibold">ℹ︎</span> <span>${text}</span>
    `;
    document.body.appendChild(alertMessage);
    setTimeout(() => {
        alertMessage.style.transform = 'translateX(0) scale(1)';
    }, 0);
    setTimeout(() => {
        alertMessage.style.opacity = '0';
        alertMessage.style.transform = 'translateX(100%) scale(1.1)';
        setTimeout(() => alertMessage.remove(), 1000);
    }, 3500);
}
function showerrorMessage(text) {
    const alertMessage = document.createElement('div');
    alertMessage.classList.add(
        'fixed', 'top-4', 'right-4', 'bg-gradient-to-r', 
        'from-red-600', 'to-red-500', 'text-white', 
        'p-5', 'rounded-lg', 'shadow-xl', 'opacity-90', 
        'z-50', 'transform', 'scale-90', 'transition-transform', 
        'border-2', 'border-red-500'
    );
    alertMessage.innerHTML = `
        <span class="font-semibold">⚠︎</span> <span>${text}</span>
    `;
    document.body.appendChild(alertMessage);
    setTimeout(() => {
        alertMessage.style.transform = 'translateX(0) scale(1)';
    }, 0);
    setTimeout(() => {
        alertMessage.style.opacity = '0';
        alertMessage.style.transform = 'translateX(100%) scale(1.1)';
        setTimeout(() => alertMessage.remove(), 1000);
    }, 4000);
}
// ツールパネル
const toolbarEl = document.getElementById('toolbar');
document.getElementById('toggleToolbar').addEventListener('click', () => toolbarEl.classList.add('open'));
document.getElementById('closeToolbar').addEventListener('click', () => toolbarEl.classList.remove('open'));

// 再生方法の設定
const playbackModal = document.getElementById('playbackModal');
const openPlaybackBtn = document.getElementById('openPlaybackSettings');
const MODE_NAMES = { normal: '通常', edu: 'Education', nocookie: 'Nocookie' };
function closePlaybackModal() {
    playbackModal.hidden = true;
    openPlaybackBtn.focus();
}
openPlaybackBtn.addEventListener('click', () => {
    const m = (document.cookie.match(/(?:^|; )playbackMode=([^;]*)/) || [])[1];
    const mode = MODE_NAMES[m] ? m : 'normal';
    document.querySelector(`input[name="playbackMode"][value="${mode}"]`).checked = true;
    document.getElementById('currentMode').textContent = MODE_NAMES[mode];
    playbackModal.hidden = false;
    document.querySelector('input[name="playbackMode"]:checked').focus();
});
document.getElementById('closePlayback').addEventListener('click', closePlaybackModal);
playbackModal.addEventListener('click', (e) => { if (e.target === playbackModal) closePlaybackModal(); });
document.getElementById('saveSettings').addEventListener('click', () => {
    const mode = document.querySelector('input[name="playbackMode"]:checked').value;
    document.cookie = `playbackMode=${mode}; path=/; max-age=31536000`;
    showMessage(`再生方法を${mode}に変更します☑️`);
    window.location.href = `/wkt/redirect/mode/<%= videoId %>?mode=${mode}`;
});
document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (!playbackModal.hidden) closePlaybackModal();
    else toolbarEl.classList.remove('open');
});

window.addEventListener("load", function() {
    if (!localStorage.getItem('tutorialCompleted')) {
       showTutorial();
    }else{
       showerrorMessage("動画の取得に失敗しました");
    }
});
  
function showTutorial() {
    const tutorialOverlay = document.createElement('div');
    tutorialOverlay.id = "tutorialOverlay";
    tutorialOverlay.style.position = 'fixed';
    tutorialOverlay.style.top = '0';
    tutorialOverlay.style.left = '0';
    tutorialOverlay.style.width = '100vw';
    tutorialOverlay.style.height = '100vh';
    tutorialOverlay.style.backgroundColor = 'rgba(0, 0, 0, 0.7)';
    tutorialOverlay.style.display = 'flex';
    tutorialOverlay.style.justifyContent = 'center';
    tutorialOverlay.style.alignItems = 'center';
    tutorialOverlay.style.zIndex = '1000';
    tutorialOverlay.innerHTML = `
        <div class="bg-gray-800 text-white p-6 rounded-lg shadow-xl w-3/4 md:w-1/2 lg:w-1/3 text-center">
            <p class="text-lg mb-6">あなたにとって最適な再生方法を設定するために協力してください！</p>
            <div class="space-y-4">
            <button id="startTutorialBtn" class="w-full bg-gray-700 py-2 rounded">設定する</button>
            <button id="skipBtn0" class="w-full bg-gray-700 py-2 rounded">設定をスキップ</button>
            </div>
        </div>
    `;
    document.body.appendChild(tutorialOverlay);
    document.getElementById('startTutorialBtn').addEventListener('click', function() {
        tutorialOverlay.remove();
        showPlaybackSettings("https://www.youtube-nocookie.com/embed/9xp1XWmJ_Wo?autoplay=1&amp;mute=0&rel=0&playlist=9xp1XWmJ_Wo", "nocookie");
    });
    document.getElementById('skipBtn0').addEventListener('click', function() {
        localStorage.setItem('tutorialCompleted', 'true');
        tutorialOverlay.remove();
        showMessage("再生方法をNormalに設定しました。<br>再生方法の変更は「コントロール」ボタンからいつでも行えます。");
        showerrorMessage("動画の取得に失敗しました");
    });
}

async function showPlaybackSettings(iframeurl, mode) {
    const settingsOverlay = document.createElement('div');
    settingsOverlay.id = "settingsOverlay";
    settingsOverlay.style.position = 'fixed';
    settingsOverlay.style.top = '0';
    settingsOverlay.style.left = '0';
    settingsOverlay.style.width = '100vw';
    settingsOverlay.style.height = '100vh';
    settingsOverlay.style.backgroundColor = 'rgba(0, 0, 0, 0.7)';
    settingsOverlay.style.display = 'flex';
    settingsOverlay.style.justifyContent = 'center';
    settingsOverlay.style.alignItems = 'center';
    settingsOverlay.style.zIndex = '1001';
    settingsOverlay.innerHTML = `
        <div class="bg-gray-800 text-white p-6 rounded-lg shadow-xl w-3/4 md:w-1/2 lg:w-1/3 text-center">
            <p class="text-lg mb-6">下に「YouTube is not currently available on this device.」と表示されていますか？</p>
            <iframe id="videoIframe" class="w-full h-64 mb-4" frameborder="0" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
            <div class="space-y-4">
                <button id="canPlayBtn" class="w-full bg-gray-700 py-2 rounded">再生できる</button>
                <button id="cannotPlayBtn" class="w-full bg-gray-700 py-2 rounded">再生できない</button>
                <button id="skipBtn" class="w-full bg-gray-700 py-2 rounded">設定をスキップ</button>
            </div>
        </div>
    `;
    document.body.appendChild(settingsOverlay);
    const iframe = document.getElementById('videoIframe');
    iframe.src = iframeurl;

    document.getElementById('canPlayBtn').addEventListener('click', function() {
        localStorage.setItem('tutorialCompleted', 'true');
        document.cookie = `playbackMode=${mode}; path=/; max-age=31536000`;
        if(mode == "nocookie"){
          showMessage("再生方法をNocookieに設定しました。");
          window.location.href = `/wkt/yt/nocookie/<%= videoId %>?tu=true`;
        } else{
          showMessage("再生方法をEducationに設定しました。");
          window.location.href = `/wkt/yt/edu/<%= videoId %>?tu=true`;
        }
    });
    document.getElementById('cannotPlayBtn').addEventListener('click',async function() {
        if (mode == "nocookie"){
          settingsOverlay.remove();
          showMessage("必要なデータを取得中です");
          const ytinfo3 = await fetch('/wkt/yt/edurl', { method: 'GET' });
          const ytinfo = await ytinfo3.text();
          showPlaybackSettings(`https://www.youtubeeducation.com/embed/9xp1XWmJ_Wo${ytinfo}&playlist=9xp1XWmJ_Wo`, "edu");
        } else {
          localStorage.setItem('tutorialCompleted', 'true');
          settingsOverlay.remove();
          showMessage("再生方法をNormalに設定しました。<br>再生方法の変更は「コントロール」ボタンからいつでも行えます。");
          showerrorMessage("動画の取得に失敗しました");
        }
    });
    document.getElementById('skipBtn').addEventListener('click', function() {
        localStorage.setItem('tutorialCompleted', 'true');
        settingsOverlay.remove();
        showMessage("再生方法をNormalに設定しました。<br>再生方法の変更は「コントロール」ボタンからいつでも行えます。");
        showerrorMessage("動画の取得に失敗しました");
    });
}
    </script>

</body>
</html>
