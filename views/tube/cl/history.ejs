<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>閲覧履歴</title>
    <link rel="stylesheet" href="/css/page.css">
    <script src="/js/tailwindcss.js"></script>
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
    <script src="https://code.jquery.com/jquery-3.5.1.js"></script>
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>
    <script src="/js/tube.js"></script>
    <style>
        .result-item {
            position: relative;
        }
        .tab-btn { transition: all 0.2s; cursor: pointer; }
    </style>
</head>
<body class="bg-gray-900 text-white">
    <header class="bg-gray-800 p-4 flex justify-between items-center fixed top-0 left-0 w-full z-10">
            <form action="/wkt/s" method="get" class="w-1/2 relative" id="searchForm">
              <input type="text" name="q" id="searchbox" placeholder="検索" value="<%= typeof query !== 'undefined' ? query : '' %>" class="searchbox w-full p-2 pr-10 rounded bg-gray-700 text-white">
              <button type="button" id="clearBtn" class="absolute right-2 top-1/2 -translate-y-1/2 flex items-center justify-center h-6 w-6 rounded-full hover:bg-gray-400 text-white text-lg leading-none hidden">
               ×
              </button>
            </form>
        <nav class="space-x-4">
            <a href="/wkt" class="text-gray-300 hover:text-white">ホーム</a>
            <a href="/wkt/trend" class="text-gray-300 hover:text-white">トレンド</a>
            <a href="/wkt/cl/fav" class="text-gray-300 hover:text-white">お気に入り</a>
            <a href="/wkt/cl/shistory" class="text-gray-300 hover:text-white">検索履歴</a>
        </nav>
    </header>
    <div class="container mx-auto p-4 mt-20 relative">
        <h2 class="text-xl font-bold mb-4">閲覧履歴</h2>
        <button id="clear-history" class="absolute top-0 right-0 m-4 px-4 py-2 bg-red-600 text-white rounded hover:bg-red-700">
            履歴を削除
        </button>
        <div class="flex space-x-6 mb-6 border-b border-gray-700 text-lg overflow-x-auto whitespace-nowrap" id="tabs">
            <button data-filter="all" data-color="border-blue-500" class="tab-btn pb-2 text-white font-bold border-b-2 border-blue-500">全て</button>
            <button data-filter="video" data-color="border-green-500" class="tab-btn pb-2 text-gray-400 font-bold hover:text-white">動画</button>
            <button data-filter="playlist" data-color="border-red-500" class="tab-btn pb-2 text-gray-400 font-bold hover:text-white">再生リスト</button>
            <button data-filter="channel" data-color="border-yellow-500" class="tab-btn pb-2 text-gray-400 font-bold hover:text-white">チャンネル</button>
        </div>
        <p id="no-history" class="hidden">最近見た動画・チャンネル・再生リストはありません(´・ω・｀)</p>
        <div id="history-list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5"></div>
        <div class="flex justify-center mt-10 mb-6">
            <button id="load-more-history" class="px-6 py-3 bg-blue-600 text-white text-lg font-semibold rounded-full shadow-md hover:bg-blue-700 transition hidden">
                もっと読み込む
            </button>
        </div>
    </div>
<script>
const HISTORY_PAGE_SIZE = 20;
const STORE_KEY = "wakametubehistory";
let currentFilter = "all";
const REMOVE_LABEL = "履歴から削除";

function getHistoryFromLocalStorage() {
    const historyData = localStorage.getItem(STORE_KEY);
    try {
        return historyData ? JSON.parse(historyData) : [];
    } catch (error) {
        console.error('Error parsing history from localStorage:', error);
        return [];
    }
}

// アイコンは保存されているURLをそのまま使う(プロキシなし)。アイコンが無い古い履歴は灰色の丸にする
function avatar(icon, name, cls) {
    return icon
        ? `<img src="${icon}" alt="${name}" class="${cls}">`
        : `<div class="${cls}"></div>`;
}

// 保存されている文字は保存時にエスケープ済み。古い履歴には無い項目があるので、あるものだけ出す
const CARDS = {
    video(v) {
        const chLink = (v.channelId && v.channelId !== "N/A") ? "/wkt/c/" + v.channelId : "/wkt/watch/" + v.videoId;
        const sub = [v.viewCount, v.published].filter(Boolean).join(" • ");
        return `
            <a href="/wkt/watch/${v.videoId}" class="block relative group">
                <img loading="lazy" src="/wkt/back/vi/${v.videoId}/mqdefault.jpg" alt="${v.videoTitle}" class="w-full h-auto rounded aspect-video object-cover">
                <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-10 transition rounded"></div>
            </a>
            <div class="mt-3 flex items-start space-x-3">
                <a href="${chLink}" class="flex-shrink-0">${avatar(v.channelIcon, v.channelName, "w-9 h-9 rounded-full object-cover bg-gray-600 border border-gray-700")}</a>
                <div class="flex-1 min-w-0">
                    <a href="/wkt/watch/${v.videoId}">
                        <p class="text-white font-bold text-sm leading-snug line-clamp-2 mb-1 hover:text-blue-400 transition">${v.videoTitle}</p>
                    </a>
                    <a href="${chLink}" class="text-gray-400 text-xs hover:text-white transition mb-0.5 block truncate">${v.channelName}</a>
                    ${sub ? `<p class="text-gray-500 text-xs">${sub}</p>` : ""}
                </div>
            </div>`;
    },
    channel(v) {
        return `
            <a href="/wkt/c/${v.channelId}">${avatar(v.channelIcon, v.channelName, "w-full h-auto aspect-square object-cover rounded bg-gray-700")}</a>
            <div class="mt-2">
                <p class="text-lg font-bold"><a href="/wkt/c/${v.channelId}" class="hover:underline">${v.channelName}</a></p>
                ${v.subsc || v.videos ? `<p class="text-xs text-gray-500">${[v.subsc, v.videos].filter(Boolean).join(" • ")}</p>` : ""}
            </div>`;
    },
    playlist(v) {
        const chLink = v.channelId ? "/wkt/c/" + v.channelId : "/wkt/p/" + v.playlistId;
        return `
            <a href="/wkt/p/${v.playlistId}" class="block relative group">
                ${v.thumbId
                    ? `<img loading="lazy" src="/wkt/back/vi/${v.thumbId}/mqdefault.jpg" alt="${v.title}" class="w-full h-auto rounded aspect-video object-cover">`
                    : `<div class="w-full aspect-video rounded bg-gray-700"></div>`}
                <span class="absolute bottom-1 right-1 bg-black bg-opacity-80 text-white text-xs px-1.5 py-0.5 rounded font-medium">プレイリスト</span>
                <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-10 transition rounded"></div>
            </a>
            <div class="mt-3 flex items-start gap-3">
                <a href="/wkt/p/${v.playlistId}" class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full border border-gray-500 bg-gray-700 text-gray-200" aria-label="プレイリストを開く">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M4 10h12v2H4zm0-4h12v2H4zm0 8h8v2H4zm10 0v6l5-3z"/></svg>
                </a>
                <div class="flex-1 min-w-0">
                    <a href="/wkt/p/${v.playlistId}"><p class="text-white font-bold text-base leading-snug line-clamp-2 mb-1 hover:underline">${v.title}</p></a>
                    ${v.channelName ? `<a href="${chLink}" class="block truncate text-sm text-gray-200 hover:underline">${v.channelName}</a>` : ""}
                    <p class="text-xs text-gray-300">プレイリスト${v.total ? " • " + v.total : ""}</p>
                </div>
            </div>`;
    }
};

// 各カードの右上の削除ボタン(カードごとに1件だけ消す)
const REMOVE_BTN = `<button type="button" data-remove title="${REMOVE_LABEL}" aria-label="${REMOVE_LABEL}" class="absolute top-5 right-5 z-10 flex h-8 w-8 items-center justify-center rounded-full bg-black bg-opacity-70 text-white hover:bg-red-600 transition">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M19 6.4 17.6 5 12 10.6 6.4 5 5 6.4 10.6 12 5 17.6 6.4 19 12 13.4 17.6 19 19 17.6 13.4 12z"/></svg>
</button>`;

// 保存分と画面のカードから1件だけ消す。全部なくなったら「ありません」を出す
function removeItem(video, item) {
    const list = getHistoryFromLocalStorage().filter(e => !wktSame(e, video));
    localStorage.setItem(STORE_KEY, JSON.stringify(list));
    item.remove();
    showMessage(REMOVE_LABEL + "しました");
    if (!document.getElementById("history-list").children.length && document.getElementById("load-more-history").classList.contains("hidden")) {
        document.getElementById("no-history").classList.remove("hidden");
    }
}

function displayHistory() {
    const history = getHistoryFromLocalStorage().reverse().filter(v => currentFilter === "all" || (v.type || "video") === currentFilter);
    const historyList = document.getElementById("history-list");
    const noHistoryMsg = document.getElementById("no-history");
    const loadMoreButton = document.getElementById("load-more-history");
    historyList.innerHTML = "";
    if (!history || history.length === 0) {
        noHistoryMsg.classList.remove("hidden");
        loadMoreButton.classList.add("hidden");
        return;
    } else {
        noHistoryMsg.classList.add("hidden");
    }
    let displayedCount = 0;
    const renderHistory = () => {
        const nextItems = history.slice(displayedCount, displayedCount + HISTORY_PAGE_SIZE);
        nextItems.forEach((video) => {
            const item = document.createElement("div");
            const card = CARDS[video.type] || CARDS.video;
            // チャンネル・再生リストは、検索ページと同じ bg-gray-600 のカード
            item.className = "result-item relative p-4 " + (video.type ? "bg-gray-600 rounded" : "bg-gray-800 rounded-lg shadow hover:bg-gray-700 transition duration-200");
            item.innerHTML = card(video) + REMOVE_BTN;
            item.querySelector("[data-remove]").addEventListener("click", () => removeItem(video, item));
            historyList.appendChild(item);
        });
        displayedCount += nextItems.length;
        if (displayedCount >= history.length) {
            loadMoreButton.classList.add("hidden");
        } else {
            loadMoreButton.classList.remove("hidden");
        }
    };
    loadMoreButton.onclick = renderHistory;
    renderHistory();
}

function clearHistory() {
  if (confirm("本当に履歴を削除しますか？")) {
    localStorage.removeItem(STORE_KEY);
    showerrorMessage("履歴を削除しました");
    displayHistory();
  }
}

document.addEventListener("DOMContentLoaded", () => {
    displayHistory();
    document.getElementById("clear-history").addEventListener("click", clearHistory);
    document.getElementById("tabs").addEventListener("click", e => {
        const btn = e.target.closest("[data-filter]");
        if (!btn) return;
        currentFilter = btn.dataset.filter;
        document.querySelectorAll("#tabs .tab-btn").forEach(t => {
            const on = t === btn;
            t.classList.toggle("text-white", on);
            t.classList.toggle("border-b-2", on);
            t.classList.toggle(t.dataset.color, on);
            t.classList.toggle("text-gray-400", !on);
        });
        displayHistory();
    });
});
  
function showMessage(text) {
    const alertMessage = document.createElement('div');
    alertMessage.classList.add(
        'fixed', 'top-4', 'right-4', 'bg-gradient-to-r', 
        'from-gray-800', 'to-gray-600', 'text-white', 
        'p-5', 'rounded-lg', 'shadow-xl', 'opacity-90', 
        'z-50', 'transform', 'scale-90', 'transition-transform', 
        'border-2', 'border-indigo-500'
    );
    alertMessage.innerHTML = `
        <span class="font-semibold">ℹ︎</span> <span>${text}</span>
    `;
    document.body.appendChild(alertMessage);
    setTimeout(() => {
        alertMessage.style.transform = 'translateX(0) scale(1)';
    }, 0);
    setTimeout(() => {
        alertMessage.style.opacity = '0';
        alertMessage.style.transform = 'translateX(100%) scale(1.1)';
        setTimeout(() => alertMessage.remove(), 1000);
    }, 3500);
}
function showerrorMessage(text) {
    const alertMessage = document.createElement('div');
    alertMessage.classList.add(
        'fixed', 'top-4', 'right-4', 'bg-gradient-to-r', 
        'from-red-600', 'to-red-500', 'text-white', 
        'p-5', 'rounded-lg', 'shadow-xl', 'opacity-90', 
        'z-50', 'transform', 'scale-90', 'transition-transform', 
        'border-2', 'border-red-500'
    );
    alertMessage.innerHTML = `
        <span class="font-semibold">⚠︎</span> <span>${text}</span>
    `;
    document.body.appendChild(alertMessage);
    setTimeout(() => {
        alertMessage.style.transform = 'translateX(0) scale(1)';
    }, 0);
    setTimeout(() => {
        alertMessage.style.opacity = '0';
        alertMessage.style.transform = 'translateX(100%) scale(1.1)';
        setTimeout(() => alertMessage.remove(), 1000);
    }, 4000);
}
</script>

<script>
const searchBox = document.getElementById('searchbox');
const clearBtn = document.getElementById('clearBtn');
function toggleClearButton() {
    clearBtn.style.display = searchBox.value ? 'block' : 'none';
}
searchBox.addEventListener('input', toggleClearButton);
clearBtn.addEventListener('click', () => {
   searchBox.value = '';
   searchBox.focus();
   toggleClearButton();
});
toggleClearButton();
</script>
</body>
</html>
