<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="dark">
    <meta name="theme-color" content="#111827">
    <title><%= (title || '動画') + ' - Twitch' %></title>
    <script>if (window.top === window.self) location.replace("/other/ttv?p=" + encodeURIComponent(location.pathname + location.search));</script>
    <script src="/js/tailwindcss.js"></script>
    <link rel="stylesheet" href="/css/page.css">
</head>

<body class="min-h-screen bg-gray-900 font-sans text-white antialiased [word-break:normal] [overflow-wrap:anywhere]">
    <main class="mx-auto max-w-6xl px-4 pb-16 pt-4 sm:pt-6">
        <div class="mx-auto max-w-5xl">
            <div id="player" class="aspect-video w-full overflow-hidden rounded-xl bg-black shadow-lg shadow-black/40 ring-1 ring-white/10"><div id="dplayer" class="h-full w-full"></div></div>
            <p id="why" role="alert" class="mt-3 hidden break-words rounded-lg border border-red-400/30 bg-red-500/10 px-4 py-3 text-sm text-red-200"></p>
            <label for="proxyToggle" class="mt-3 flex min-h-[44px] cursor-pointer select-none items-center justify-between gap-3 rounded-xl bg-white/10 px-4 py-2 transition-colors hover:bg-white/20 focus-within:ring-2 focus-within:ring-blue-400">
                <span class="text-sm font-semibold">☁️ プロキシ経由で再生</span>
                <input type="checkbox" id="proxyToggle" class="h-5 w-5 shrink-0 cursor-pointer accent-blue-500">
            </label>
            <% if (title || name) { %>
            <h1 class="mt-5 break-words text-xl font-bold leading-snug sm:text-2xl"><%= title || '(無題)' %></h1>
            <% if (u && name) { %>
            <a href="/other/ttv/ch/<%= encodeURIComponent(u) %>" class="mt-3 flex min-h-[48px] w-fit max-w-full items-center gap-3 rounded-full pr-4 transition-colors hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 focus-visible:ring-offset-2 focus-visible:ring-offset-gray-900">
                <% if (avatar) { %><img src="<%= avatar %>" alt="" referrerpolicy="no-referrer" class="h-12 w-12 shrink-0 rounded-full bg-gray-800 object-cover ring-1 ring-white/10"><% } else { %><span class="w-2"></span><% } %>
                <span class="min-w-0 truncate font-semibold"><%= name %></span>
            </a>
            <% } %>
            <p class="mt-1 text-[13px] text-gray-300 sm:text-sm">
                <% let sep = false; %>
                <% if (game) { %><a href="/other/ttv/cat/<%= encodeURIComponent(game.slug) %>" class="inline-block hover:underline"><%= game.name %></a><% sep = true; } %>
                <% if (views != null) { %><%= sep ? ' ・ ' : '' %><span class="inline-block"><%= Number(views).toLocaleString('ja-JP') %>回視聴</span><% sep = true; } %>
                <% if (date) { %><%= sep ? ' ・ ' : '' %><span class="inline-block"><%= date %></span><% } %>
            </p>
            <% } %>
        </div>
    </main>
    <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
    <script src="https://cdn.jsdelivr.net/gh/tsukumijima/DPlayer@master/dist/DPlayer.min.js"></script>
    <script>
        const src = <%- json(src) %>;
        const why = document.getElementById("why");
        const proxyToggle = document.getElementById("proxyToggle");
        let dp = null;

        // プロキシ (watch.ejs と同じ仕組み。この機能用に別のキーで保存する)
        function getProxyUrl() { return localStorage.getItem("ttvProxyUrl") || ""; }
        function isProxyEnabled() { return localStorage.getItem("ttvProxyEnabled") === "true" && !!getProxyUrl(); }
        function applyProxy(url) { return isProxyEnabled() ? getProxyUrl() + encodeURIComponent(url) : url; }
        // ブラウザ標準のダイアログでURLを入力してもらう。使わない(キャンセル)なら null
        function askProxy() {
            let value = getProxyUrl();
            for (;;) {
                const input = prompt("プロキシ経由で再生\n\nTwitchの動画サーバーは他のサイトからの直接の読み込みを許可していないため、通常再生ができない場合の最終手段です。再生リストと映像データのすべてがプロキシを通るので、プロキシの通信量が大きくなります。\n\n使用するプロキシのURLを入力してください。（例: https://example.com/?url=）\n\n【キャンセル】プロキシを使用しない", value);
                if (input === null) return null;
                value = input.trim();
                if (/^https?:\/\/\S+$/i.test(value)) return value;
                alert("http:// または https:// から始まるURLを入力してください。");
            }
        }
        function showWhy(text) { why.textContent = text; why.classList.remove("hidden"); }

        function startPlayer(seek) {
            if (dp) dp.destroy();
            why.classList.add("hidden");
            if (!src) { showWhy("再生用のURLを取得できませんでした。Twitch側で拒否された可能性があります。"); return; }
            dp = new DPlayer({
                container: document.getElementById("dplayer"), autoplay: true, lang: "ja",
                video: { url: src, type: "hls" },
                // 再生リストも映像データも、すべての通信の送り先をプロキシ経由に書き換える(プロキシがオフなら元のまま)
                pluginOptions: { hls: { xhrSetup: function (xhr, url) { xhr.open("GET", applyProxy(url), true); } } }
            });
            if (seek > 1) dp.video.addEventListener("loadedmetadata", function () { dp.seek(seek); }, { once: true });
            if (dp.plugins.hls) {
                dp.plugins.hls.on(Hls.Events.ERROR, function (_, d) {
                    console.warn("hls.js error", d);
                    if (d.fatal) showWhy("再生できませんでした。原因: " + d.type + " / " + d.details + (d.response ? " / HTTP " + d.response.code : "") + (isProxyEnabled() ? "（プロキシが再生リストや映像データを返せていない可能性があります）" : "（「プロキシ経由で再生」をオンにすると再生できることがあります）"));
                });
            }
        }

        proxyToggle.checked = isProxyEnabled();
        proxyToggle.addEventListener("change", function () {
            if (this.checked) {
                const chosen = askProxy();
                if (!chosen) { this.checked = false; localStorage.setItem("ttvProxyEnabled", "false"); return; }
                localStorage.setItem("ttvProxyUrl", chosen);
                localStorage.setItem("ttvProxyEnabled", "true");
            } else {
                localStorage.setItem("ttvProxyEnabled", "false");
            }
            startPlayer(dp ? dp.video.currentTime : 0);
        });
        startPlayer(0);
    </script>
</body>
</html>
