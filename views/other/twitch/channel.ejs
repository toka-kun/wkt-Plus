<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="dark">
    <meta name="theme-color" content="#111827">
    <title><%= name %> - Twitch</title>
    <script>if (window.top === window.self) location.replace("/other/ttv?p=" + encodeURIComponent(location.pathname + location.search));</script>
    <script src="/js/tailwindcss.js"></script>
    <link rel="stylesheet" href="/css/page.css">
</head>

<body class="min-h-screen bg-gray-900 font-sans text-white antialiased [word-break:normal] [overflow-wrap:anywhere]">
    <main class="mx-auto max-w-6xl px-4 pb-16 pt-4 sm:pt-6">
        <% if (banner) { %>
        <div class="relative overflow-hidden rounded-xl bg-gray-800 ring-1 ring-white/10">
            <img src="<%= banner %>" alt="" referrerpolicy="no-referrer" class="h-32 w-full object-cover sm:h-48">
            <div class="absolute inset-0 bg-gradient-to-t from-gray-900/60 to-transparent"></div>
        </div>
        <% } %>
        <div class="flex items-center gap-4 <%= banner ? '-mt-8 px-4' : '' %>">
            <img src="<%= avatar %>" alt="" referrerpolicy="no-referrer" class="relative h-20 w-20 shrink-0 rounded-full bg-gray-800 object-cover ring-4 ring-gray-900 sm:h-24 sm:w-24">
            <div class="min-w-0 <%= banner ? 'pt-8' : '' %>">
                <h1 class="flex flex-wrap items-center gap-x-2 gap-y-1 text-2xl font-bold tracking-tight">
                    <span class="min-w-0 break-words"><%= name %></span>
                    <% if (badge) { %><span class="whitespace-nowrap rounded bg-purple-600 px-2 py-0.5 text-xs font-semibold text-white"><%= badge %></span><% } %>
                </h1>
                <% if (followers != null) { %><p class="text-sm text-gray-300"><%= Number(followers).toLocaleString('ja-JP') %>フォロワー</p><% } %>
                <% if (team) { %><p class="text-sm text-gray-300">チーム: <%= team %></p><% } %>
            </div>
        </div>
        <div class="mt-4 flex flex-wrap items-center gap-3">
            <% if (isLive) { %>
            <a href="/other/ttv/l/<%= encodeURIComponent(u) %>" class="inline-flex min-h-[44px] items-center gap-2 rounded-full bg-red-600 px-5 text-sm font-semibold text-white transition-colors hover:bg-red-500 motion-safe:active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 focus-visible:ring-offset-2 focus-visible:ring-offset-gray-900">
                <span class="h-2 w-2 rounded-full bg-white motion-safe:animate-pulse" aria-hidden="true"></span>
                <span>LIVE<% if (game) { %> ・ <%= game.name %><% } %></span>
            </a>
            <% } else { %>
            <p class="text-sm text-gray-300">オフライン<% if (lastGame) { %> ・ 最後の配信: <%= lastGame %><% } %></p>
            <% } %>
        </div>
        <% if (description || nextStream || socials.length) { %>
        <section class="mt-5 rounded-xl border border-white/10 bg-white/[0.04] p-4 sm:p-5" aria-label="チャンネルの紹介">
            <% if (description) { %><p class="whitespace-pre-line text-[15px] leading-relaxed text-gray-200"><%= description %></p><% } %>
            <% if (nextStream) { %>
            <p class="<%= description ? 'mt-4' : '' %> text-sm text-gray-300"><span class="text-gray-400">次の配信予定:</span> <time data-local datetime="<%= nextStream %>" class="font-semibold text-white"><%= nextStream %></time></p>
            <% } %>
            <% if (socials.length) { %>
            <ul class="<%= description || nextStream ? 'mt-4' : '' %> flex flex-wrap gap-2">
                <% socials.forEach(function (x) { %>
                <li><a href="<%= x.url %>" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-[44px] items-center gap-2 rounded-full bg-white/10 px-4 text-sm text-gray-100 transition-colors hover:bg-white/20 motion-safe:active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 focus-visible:ring-offset-2 focus-visible:ring-offset-gray-900"><%= x.title %><span aria-hidden="true">↗</span><span class="sr-only">(新しいタブで開く)</span></a></li>
                <% }) %>
            </ul>
            <% } %>
        </section>
        <% } %>
        <nav aria-label="チャンネルの表示" class="mt-6 flex flex-wrap gap-2">
            <a href="/other/ttv/ch/<%= encodeURIComponent(u) %>" <%= tab === 'home' ? 'aria-current="page"' : '' %> class="inline-flex min-h-[44px] items-center justify-center gap-2 whitespace-nowrap rounded-full px-5 text-sm font-semibold transition-colors motion-safe:active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 focus-visible:ring-offset-2 focus-visible:ring-offset-gray-900 <%= tab === 'home' ? 'bg-blue-600 text-white hover:bg-blue-700' : 'bg-white/10 text-gray-100 hover:bg-white/20' %>">ホーム</a>
            <a href="/other/ttv/ch/<%= encodeURIComponent(u) %>/videos" <%= tab === 'videos' ? 'aria-current="page"' : '' %> class="inline-flex min-h-[44px] items-center justify-center gap-2 whitespace-nowrap rounded-full px-5 text-sm font-semibold transition-colors motion-safe:active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 focus-visible:ring-offset-2 focus-visible:ring-offset-gray-900 <%= tab === 'videos' ? 'bg-blue-600 text-white hover:bg-blue-700' : 'bg-white/10 text-gray-100 hover:bg-white/20' %>">動画</a>
            <a href="/other/ttv/ch/<%= encodeURIComponent(u) %>/clips" <%= tab === 'clips' ? 'aria-current="page"' : '' %> class="inline-flex min-h-[44px] items-center justify-center gap-2 whitespace-nowrap rounded-full px-5 text-sm font-semibold transition-colors motion-safe:active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 focus-visible:ring-offset-2 focus-visible:ring-offset-gray-900 <%= tab === 'clips' ? 'bg-blue-600 text-white hover:bg-blue-700' : 'bg-white/10 text-gray-100 hover:bg-white/20' %>">クリップ</a>
        </nav>
        <%
            // ホームは棚ごと、動画・クリップは1つの一覧
            const groups = tab === 'home' ? shelves : [{ heading: '', more: '', cards: cards }];
        %>
        <% if (tab !== 'home' && !cards.length) { %>
        <div class="mt-6 flex flex-col items-center gap-3 rounded-xl border border-dashed border-white/15 px-6 py-12 text-center text-gray-300">
            <svg class="h-10 w-10 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path stroke-linecap="round" stroke-linejoin="round" d="M10 9.5v5l4-2.5z"/></svg>
            <p><%= tab === 'clips' ? 'クリップがありません。' : '動画がありません。' %></p>
        </div>
        <% } %>
        <% groups.forEach(function (s) { %>
        <section class="<%= s.heading ? 'mt-8' : 'mt-5' %>">
            <% if (s.heading) { %>
            <div class="mb-3 flex items-center justify-between gap-3">
                <h2 class="text-lg font-bold"><%= s.heading %></h2>
                <% if (s.more) { %><a href="/other/ttv/ch/<%= encodeURIComponent(u) %>/<%= s.more %>" class="inline-flex min-h-[44px] items-center rounded-full px-3 text-sm font-semibold text-blue-300 transition-colors hover:text-blue-200 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 focus-visible:ring-offset-2 focus-visible:ring-offset-gray-900">すべて見る</a><% } %>
            </div>
            <% } %>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                <% s.cards.forEach(function (c) { %>
                <a href="<%= c.href %>" class="result-item group block min-w-0 rounded-lg motion-reduce:!transform-none motion-reduce:transition-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 focus-visible:ring-offset-2 focus-visible:ring-offset-gray-900">
                    <div class="relative overflow-hidden bg-gray-800 ring-1 ring-white/10 aspect-video rounded-lg">
                        <img src="<%= c.img %>" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" class="h-full w-full object-cover">
                        <% if (c.badge && c.live) { %>
                        <span class="absolute left-2 top-2 whitespace-nowrap rounded bg-red-600 px-1.5 py-0.5 text-xs font-bold tabular-nums text-white shadow">LIVE <%= c.badge %></span>
                        <% } else if (c.badge) { %>
                        <span class="absolute bottom-2 right-2 whitespace-nowrap rounded bg-black/80 px-1.5 py-0.5 text-xs font-semibold tabular-nums text-white"><%= c.badge %></span>
                        <% } %>
                    </div>
                    <p class="mt-2 line-clamp-2 text-[15px] font-semibold leading-snug transition-colors group-hover:text-blue-300"><%= c.title %></p>
                    <% if (c.sub) { %><p class="truncate text-[13px] text-gray-300"><%= c.sub %></p><% } %>
                    <% if (c.meta) { %><p class="truncate text-[13px] text-gray-400"><%= c.meta %></p><% } %>
                </a>
                <% }) %>
            </div>
        </section>
        <% }) %>
        <% if (next) { %>
        <div class="mt-8 flex justify-center">
            <a href="<%= next %>" class="inline-flex min-h-[44px] w-full items-center justify-center rounded-full bg-white/10 px-8 text-sm font-semibold transition-colors hover:bg-white/20 motion-safe:active:scale-95 sm:w-auto focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 focus-visible:ring-offset-2 focus-visible:ring-offset-gray-900">もっと見る</a>
        </div>
        <% } %>
    </main>
    <script>
        document.querySelectorAll("time[data-local]").forEach(function (t) {
            const d = new Date(t.dateTime);
            if (!isNaN(d)) t.textContent = d.toLocaleString("ja-JP", { dateStyle: "medium", timeStyle: "short" });
        });
    </script>
</body>
</html>
