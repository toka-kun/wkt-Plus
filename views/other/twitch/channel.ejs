<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="dark">
    <meta name="theme-color" content="#111827">
    <title><%= name %> - Twitch</title>
    <script>if (window.top === window.self) location.replace("/other/ttv?p=" + encodeURIComponent(location.pathname + location.search));</script>
    <script src="/js/tailwindcss.js"></script>
    <link rel="stylesheet" href="/css/page.css">
</head>

<body class="bg-gray-900 font-sans min-h-screen text-white">
    <main class="mx-auto max-w-6xl px-4 pb-16 pt-4">
        <% if (banner) { %>
        <img src="<%= banner %>" alt="" referrerpolicy="no-referrer" class="mb-4 h-32 w-full rounded-lg bg-gray-800 object-cover sm:h-48">
        <% } %>
        <div class="flex items-center gap-4">
            <img src="<%= avatar %>" alt="" referrerpolicy="no-referrer" class="h-16 w-16 shrink-0 rounded-full bg-gray-800 object-cover">
            <div class="min-w-0">
                <h1 class="flex flex-wrap items-center gap-2 text-xl font-bold">
                    <span class="truncate"><%= name %></span>
                    <% if (badge) { %><span class="rounded bg-purple-600 px-2 py-0.5 text-xs font-semibold"><%= badge %></span><% } %>
                </h1>
                <% if (followers != null || team) { %>
                <p class="text-sm text-gray-400">
                    <% if (followers != null) { %><%= Number(followers).toLocaleString('ja-JP') %>フォロワー<% } %>
                    <% if (team) { %><%= followers != null ? ' ・ ' : '' %>チーム: <%= team %><% } %>
                </p>
                <% } %>
                <% if (isLive) { %>
                <a href="/other/ttv/l/<%= encodeURIComponent(u) %>" class="mt-1 inline-flex items-center gap-2 rounded-full bg-red-600 px-3 py-1 text-sm font-semibold hover:bg-red-500">
                    LIVE<% if (game) { %> ・ <%= game.name %><% } %>
                </a>
                <% } else { %>
                <p class="text-sm text-gray-400">オフライン<% if (lastGame) { %> ・ 最後の配信: <%= lastGame %><% } %></p>
                <% } %>
            </div>
        </div>
        <% if (description) { %><p class="mt-4 whitespace-pre-line break-words text-sm text-gray-300"><%= description %></p><% } %>
        <% if (nextStream) { %><p class="mt-3 text-sm text-gray-300">次の配信予定: <time data-local datetime="<%= nextStream %>"><%= nextStream %></time></p><% } %>
        <% if (socials.length) { %>
        <div class="mt-3 flex flex-wrap gap-2">
            <% socials.forEach(function (x) { %>
            <a href="<%= x.url %>" target="_blank" rel="noopener noreferrer" class="rounded-full bg-white/10 px-4 py-1.5 text-sm hover:bg-white/20"><%= x.title %></a>
            <% }) %>
        </div>
        <% } %>
        <div class="mt-6 flex gap-2">
            <a href="/other/ttv/ch/<%= encodeURIComponent(u) %>" class="rounded-full px-5 py-2 text-sm font-semibold transition-colors <%= tab === 'home' ? 'bg-blue-500' : 'bg-white/10 hover:bg-white/20' %>">ホーム</a>
            <a href="/other/ttv/ch/<%= encodeURIComponent(u) %>/videos" class="rounded-full px-5 py-2 text-sm font-semibold transition-colors <%= tab === 'videos' ? 'bg-blue-500' : 'bg-white/10 hover:bg-white/20' %>">動画</a>
            <a href="/other/ttv/ch/<%= encodeURIComponent(u) %>/clips" class="rounded-full px-5 py-2 text-sm font-semibold transition-colors <%= tab === 'clips' ? 'bg-blue-500' : 'bg-white/10 hover:bg-white/20' %>">クリップ</a>
        </div>
        <%
            // ホームは棚ごと、動画・クリップは1つの一覧
            const groups = tab === 'home' ? shelves : [{ heading: '', cards: cards }];
        %>
        <% if (tab !== 'home' && !cards.length) { %><p class="mt-4 text-gray-400"><%= tab === 'clips' ? 'クリップがありません。' : '動画がありません。' %></p><% } %>
        <% groups.forEach(function (s) { %>
        <% if (s.heading) { %><h2 class="mb-3 mt-6 text-lg font-bold"><%= s.heading %></h2><% } else { %><div class="mt-4"></div><% } %>
        <div class="grid gap-4 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
            <% s.cards.forEach(function (c) { %>
            <a href="<%= c.href %>" class="result-item block min-w-0">
                <div class="relative aspect-video overflow-hidden rounded-lg bg-gray-800">
                    <img src="<%= c.img %>" alt="" loading="lazy" referrerpolicy="no-referrer" class="h-full w-full object-cover">
                    <% if (c.badge) { %>
                    <span class="absolute left-2 top-2 rounded px-1.5 py-0.5 text-xs font-semibold tabular-nums <%= c.live ? 'bg-red-600' : 'bg-black/70' %>"><%= c.live ? 'LIVE ' : '' %><%= c.badge %></span>
                    <% } %>
                </div>
                <p class="mt-2 truncate text-sm font-semibold"><%= c.title %></p>
                <% if (c.sub) { %><p class="truncate text-xs text-gray-400"><%= c.sub %></p><% } %>
                <% if (c.meta) { %><p class="truncate text-xs text-gray-500"><%= c.meta %></p><% } %>
            </a>
            <% }) %>
        </div>
        <% }) %>
        <% if (next) { %>
        <div class="mt-6 text-center">
            <a href="<%= next %>" class="inline-block rounded-full bg-white/10 px-6 py-3 text-sm font-semibold transition-colors hover:bg-white/20">もっと見る</a>
        </div>
        <% } %>
    </main>
    <script>
        document.querySelectorAll("time[data-local]").forEach(function (t) {
            const d = new Date(t.dateTime);
            if (!isNaN(d)) t.textContent = d.toLocaleString("ja-JP", { dateStyle: "medium", timeStyle: "short" });
        });
    </script>
</body>
</html>
