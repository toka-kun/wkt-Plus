<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="dark">
    <meta name="theme-color" content="#111827">
    <title><%= (q ? q + ' の検索結果 - ' : '') + 'Twitch' %></title>
    <script>if (window.top === window.self) location.replace("/other/ttv?p=" + encodeURIComponent(location.pathname + location.search));</script>
    <script src="/js/tailwindcss.js"></script>
    <link rel="stylesheet" href="/css/page.css">
</head>

<body class="bg-gray-900 font-sans min-h-screen text-white">
    <main class="mx-auto max-w-6xl px-4 pb-16 pt-4">
        <% if (!q) { %>
        <p class="mt-4 text-gray-400">上の検索バーにキーワードを入力してください。</p>
        <% } else { %>
        <h1 class="text-lg font-bold">「<%= q %>」の検索結果</h1>
        <% if (!sections.length) { %><p class="mt-4 text-gray-400">一致する結果はありません。</p><% } %>
        <% } %>
        <% sections.forEach(function (s) {
            // kind: wide(16:9) / game(縦長) / channel(丸アイコン)
            const cols = s.kind === 'game' ? 'grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6'
                : s.kind === 'channel' ? 'grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5'
                : 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3';
            const shape = s.kind === 'game' ? 'aspect-[3/4] rounded-lg'
                : s.kind === 'channel' ? 'aspect-square rounded-full'
                : 'aspect-video rounded-lg';
            const center = s.kind === 'channel' ? 'text-center' : '';
        %>
        <h2 class="mb-3 mt-6 text-lg font-bold"><%= s.heading %></h2>
        <div class="grid gap-4 <%= cols %>">
            <% s.cards.forEach(function (c) { %>
            <a href="<%= c.href %>" class="result-item block min-w-0">
                <div class="relative overflow-hidden bg-gray-800 <%= shape %>">
                    <img src="<%= c.img %>" alt="" loading="lazy" referrerpolicy="no-referrer" class="h-full w-full object-cover">
                    <% if (c.badge) { %>
                    <span class="absolute left-2 top-2 rounded px-1.5 py-0.5 text-xs font-semibold tabular-nums <%= c.live ? 'bg-red-600' : 'bg-black/70' %>"><%= c.live ? 'LIVE ' : '' %><%= c.badge %></span>
                    <% } %>
                </div>
                <p class="mt-2 truncate text-sm font-semibold <%= center %>"><%= c.title %></p>
                <% if (c.sub) { %><p class="truncate text-xs text-gray-400 <%= center %>"><%= c.sub %></p><% } %>
                <% if (c.meta) { %><p class="truncate text-xs text-gray-500"><%= c.meta %></p><% } %>
            </a>
            <% }) %>
        </div>
        <% }) %>
    </main>
</body>
</html>
