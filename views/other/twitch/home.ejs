<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="dark">
    <meta name="theme-color" content="#111827">
    <title>Twitch</title>
    <script src="/js/tailwindcss.js"></script>
    <link rel="stylesheet" href="/css/page.css">
    <!-- 検索候補は tube の検索ボックスと同じ仕組み(jQuery UI の autocomplete) -->
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
    <script src="https://code.jquery.com/jquery-3.5.1.js"></script>
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>
    <style>
        .ui-autocomplete { z-index: 100; max-height: 60vh; overflow-x: hidden; overflow-y: auto; }
    </style>
</head>

<body class="overflow-hidden bg-gray-900 font-sans text-white">
    <header class="fixed inset-x-0 top-0 z-40 h-[72px] bg-gray-900">
        <div class="mx-auto flex h-full max-w-6xl items-center gap-2 px-3">
            <a href="/wkt" aria-label="戻る" title="戻る" class="back-button flex h-12 shrink-0 items-center gap-1 rounded-lg bg-blue-500 px-3 font-semibold text-white shadow-lg transition-all duration-300 ease-in-out hover:bg-blue-600">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                </svg>
                <span class="hidden sm:inline">戻る</span>
            </a>

            <form id="searchForm" action="/other/ttv/s" method="get" target="view" role="search" class="flex min-w-0 flex-1 items-center gap-2">
                <a href="/other/ttv/cat" target="view" aria-label="ホーム" title="ホーム" class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400">
                    <svg class="h-6 w-6 fill-current" viewBox="0 0 256 256" aria-hidden="true"><path d="M219.31,108.68l-80-80a16,16,0,0,0-22.62,0l-80,80A15.87,15.87,0,0,0,32,120v96a8,8,0,0,0,8,8h64a8,8,0,0,0,8-8V160h32v56a8,8,0,0,0,8,8h64a8,8,0,0,0,8-8V120A15.87,15.87,0,0,0,219.31,108.68ZM208,208H160V152a8,8,0,0,0-8-8H104a8,8,0,0,0-8,8v56H48V120l80-80,80,80Z"/></svg>
                </a>
                <div class="relative min-w-0 flex-1">
                    <label for="searchbox" class="sr-only">検索</label>
                    <input id="searchbox" name="q" type="text" maxlength="100" autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="search" placeholder="チャンネル・カテゴリー・動画を検索..." class="h-12 w-full rounded-full border-0 bg-white/10 pl-5 pr-11 text-[1.2rem] text-white placeholder-gray-400 outline-none transition-[background-color,box-shadow] duration-300 focus:bg-white/30 focus:shadow-[0_0_8px_rgba(255,255,255,0.5)]">
                    <button type="button" id="clearBtn" aria-label="入力を消す" style="display:none" class="absolute right-3 top-1/2 h-6 w-6 -translate-y-1/2 items-center justify-center rounded-full text-lg leading-none text-white hover:bg-white/30">×</button>
                </div>
                <button type="submit" aria-label="検索" class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400">
                    <svg class="h-6 w-6 fill-current" viewBox="0 0 256 256" aria-hidden="true"><path d="M229.66,218.34l-50.07-50.06a88.11,88.11,0,1,0-11.31,11.31l50.06,50.07a8,8,0,0,0,11.32-11.32ZM40,112a72,72,0,1,1,72,72A72.08,72.08,0,0,1,40,112Z"/></svg>
                </button>
            </form>
        </div>
    </header>

    <!-- 検索・ライブ・VOD・クリップ・チャンネル・カテゴリーの各ページは、この中に表示する -->
    <div class="fixed inset-x-0 bottom-0 top-[72px]">
        <iframe name="view" id="view" title="Twitch" allow="fullscreen; autoplay" allowfullscreen class="h-full w-full border-0 bg-gray-900"></iframe>
    </div>

    <script>
        const DEFAULT_PAGE = "/other/ttv/cat";
        const HISTORY_KEY = "ttvSearchHistory";
        const view = document.getElementById("view");
        const box = document.getElementById("searchbox");
        const clearBtn = document.getElementById("clearBtn");

        // ---- 最初に表示するページ。/other/ttv?p=/other/ttv/l/名前 のように、中のページを直接指定もできる ----
        const p = new URLSearchParams(location.search).get("p");
        const validPage = typeof p === "string" && p.startsWith("/other/ttv/") && !p.includes("..") && !/[\r\n\\]/.test(p);
        view.src = validPage ? p : DEFAULT_PAGE;

        // ---- 検索履歴 (tube と同じ仕組み。保存先だけ別にして、YouTubeの検索履歴とは混ぜない) ----
        function getSearchHistory() {
            try { return JSON.parse(localStorage.getItem(HISTORY_KEY)) || []; } catch (e) { return []; }
        }
        function updateSearchHistory(query) {
            let history = getSearchHistory().filter(function (item) { return item !== query; });
            history.unshift(query);
            if (history.length > 16) history = history.slice(0, 16);
            localStorage.setItem(HISTORY_KEY, JSON.stringify(history));
        }
        function historyItems() {
            return getSearchHistory().map(function (q) { return { label: q, value: q }; });
        }

        // ---- 検索候補。入力が空なら検索履歴、入力中はTwitchの候補(候補が無い・取れない時は履歴) ----
        $(function () {
            $("#searchbox").autocomplete({
                source: function (request, response) {
                    const term = request.term.trim();
                    if (!term) return response(historyItems());
                    $.ajax({
                        url: "/other/ttv/suggest",
                        data: { q: term },
                        success: function (data) { response(data.length > 0 ? data : historyItems()); },
                        error: function () { response(historyItems()); }
                    });
                },
                delay: 250, // 入力のたびにTwitchへ問い合わせるので、tubeより少し間を空ける
                minLength: 0,
                select: function (event, ui) {
                    $("#searchbox").val(ui.item.value);
                    if (ui.item.href) {
                        // チャンネル・カテゴリーの候補は、検索せずに直接開く
                        updateSearchHistory(ui.item.value);
                        view.src = ui.item.href;
                    } else {
                        $("#searchForm")[0].requestSubmit();
                    }
                    syncClear();
                    return false;
                }
            });
            $("#searchbox").on("focus", function () { $(this).autocomplete("search", $(this).val()); });
        });

        // 検索を実行した時に履歴へ保存する
        document.getElementById("searchForm").addEventListener("submit", function () {
            const q = box.value.trim();
            if (q) updateSearchHistory(q);
        });

        // × ボタン
        function syncClear() { clearBtn.style.display = box.value ? "flex" : "none"; }
        box.addEventListener("input", syncClear);
        clearBtn.addEventListener("click", function () { box.value = ""; box.focus(); syncClear(); });

        // ---- 中のページが切り替わった時: タブの題名とURLを合わせる(再読み込みしても同じページに戻れる) ----
        view.addEventListener("load", function () {
            let path = DEFAULT_PAGE;
            try {
                const w = view.contentWindow;
                path = w.location.pathname + w.location.search;
                document.title = w.document.title || "Twitch";
                if (w.location.pathname === "/other/ttv/s") {
                    box.value = new URLSearchParams(w.location.search).get("q") || "";
                    syncClear();
                }
            } catch (e) { /* 読めない時は何もしない */ }
            history.replaceState(null, "", path === DEFAULT_PAGE ? location.pathname : location.pathname + "?p=" + encodeURIComponent(path));
        });
    </script>
</body>
</html>
