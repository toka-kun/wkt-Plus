<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="dark">
    <meta name="theme-color" content="#111827">
    <title><%= mode === 'list' ? '人気のカテゴリー' : name %> - Twitch</title>
    <script>if (window.top === window.self) location.replace("/other/ttv?p=" + encodeURIComponent(location.pathname + location.search));</script>
    <script src="/js/tailwindcss.js"></script>
    <link rel="stylesheet" href="/css/page.css">
</head>

<body class="bg-gray-900 font-sans min-h-screen text-white">
    <main class="mx-auto max-w-6xl px-4 pb-16 pt-4">
        <%
            const isList = mode === 'list';
            const cols = isList ? 'grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6' : 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3';
            const shape = isList ? 'aspect-[3/4] rounded-lg' : 'aspect-video rounded-lg';
        %>
        <h1 class="mb-3 text-lg font-bold"><%= isList ? '人気のカテゴリー' : name %></h1>
        <% if (!isList) { %>
        <div class="mb-4 flex gap-2">
            <a href="/other/ttv/cat/<%= encodeURIComponent(g) %>" class="rounded-full px-5 py-2 text-sm font-semibold transition-colors <%= mode === 'live' ? 'bg-blue-500' : 'bg-white/10 hover:bg-white/20' %>">ライブ</a>
            <a href="/other/ttv/cat/<%= encodeURIComponent(g) %>/clips" class="rounded-full px-5 py-2 text-sm font-semibold transition-colors <%= mode === 'clips' ? 'bg-blue-500' : 'bg-white/10 hover:bg-white/20' %>">クリップ</a>
        </div>
        <% } %>
        <% if (!cards.length) { %><p class="text-gray-400"><%= isList ? 'カテゴリーがありません。' : mode === 'clips' ? 'クリップがありません。' : 'いまライブ中の配信はありません。' %></p><% } %>
        <div class="grid gap-4 <%= cols %>">
            <% cards.forEach(function (c) { %>
            <a href="<%= c.href %>" class="result-item block min-w-0">
                <div class="relative overflow-hidden bg-gray-800 <%= shape %>">
                    <img src="<%= c.img %>" alt="" loading="lazy" referrerpolicy="no-referrer" class="h-full w-full object-cover">
                    <% if (c.badge) { %>
                    <span class="absolute left-2 top-2 rounded px-1.5 py-0.5 text-xs font-semibold tabular-nums <%= c.live ? 'bg-red-600' : 'bg-black/70' %>"><%= c.live ? 'LIVE ' : '' %><%= c.badge %></span>
                    <% } %>
                </div>
                <p class="mt-2 truncate text-sm font-semibold"><%= c.title %></p>
                <% if (c.sub) { %><p class="truncate text-xs text-gray-400"><%= c.sub %></p><% } %>
                <% if (c.meta) { %><p class="truncate text-xs text-gray-500"><%= c.meta %></p><% } %>
            </a>
            <% }) %>
        </div>
        <% if (next) { %>
        <div class="mt-6 text-center">
            <a href="<%= next %>" class="inline-block rounded-full bg-white/10 px-6 py-3 text-sm font-semibold transition-colors hover:bg-white/20">もっと見る</a>
        </div>
        <% } %>
    </main>
</body>
</html>
