<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="dark">
    <meta name="theme-color" content="#111827">
    <title><%= mode === 'list' ? '人気のカテゴリー' : name %> - Twitch</title>
    <script>if (window.top === window.self) location.replace("/other/ttv?p=" + encodeURIComponent(location.pathname + location.search));</script>
    <script src="/js/tailwindcss.js"></script>
    <link rel="stylesheet" href="/css/page.css">
</head>

<body class="min-h-screen bg-gray-900 font-sans text-white antialiased [word-break:normal] [overflow-wrap:anywhere]">
    <main class="mx-auto max-w-6xl px-4 pb-16 pt-4 sm:pt-6">
        <%
            const isList = mode === 'list';
            const cols = isList ? 'grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6' : 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3';
            const shape = isList ? 'aspect-[3/4] rounded-lg' : 'aspect-video rounded-lg';
        %>
        <h1 class="text-2xl font-bold tracking-tight"><%= isList ? '人気のカテゴリー' : name %></h1>
        <% if (!isList) { %>
        <nav aria-label="表示の切り替え" class="mt-4 flex flex-wrap gap-2">
            <a href="/other/ttv/cat/<%= encodeURIComponent(g) %>" <%= mode === 'live' ? 'aria-current="page"' : '' %> class="inline-flex min-h-[44px] items-center justify-center gap-2 whitespace-nowrap rounded-full px-5 text-sm font-semibold transition-colors motion-safe:active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 focus-visible:ring-offset-2 focus-visible:ring-offset-gray-900 <%= mode === 'live' ? 'bg-blue-600 text-white hover:bg-blue-700' : 'bg-white/10 text-gray-100 hover:bg-white/20' %>">ライブ</a>
            <a href="/other/ttv/cat/<%= encodeURIComponent(g) %>/clips" <%= mode === 'clips' ? 'aria-current="page"' : '' %> class="inline-flex min-h-[44px] items-center justify-center gap-2 whitespace-nowrap rounded-full px-5 text-sm font-semibold transition-colors motion-safe:active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 focus-visible:ring-offset-2 focus-visible:ring-offset-gray-900 <%= mode === 'clips' ? 'bg-blue-600 text-white hover:bg-blue-700' : 'bg-white/10 text-gray-100 hover:bg-white/20' %>">クリップ</a>
        </nav>
        <% } %>
        <div class="mt-5">
            <% if (!cards.length) { %>
            <div class="mt-0 flex flex-col items-center gap-3 rounded-xl border border-dashed border-white/15 px-6 py-12 text-center text-gray-300">
                <svg class="h-10 w-10 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path stroke-linecap="round" stroke-linejoin="round" d="M10 9.5v5l4-2.5z"/></svg>
                <p><%= isList ? 'カテゴリーがありません。' : mode === 'clips' ? 'クリップがありません。' : 'いまライブ中の配信はありません。' %></p>
            </div>
            <% } %>
            <div class="grid gap-4 <%= cols %>">
                <% cards.forEach(function (c) { %>
                <a href="<%= c.href %>" class="result-item group block min-w-0 rounded-lg motion-reduce:!transform-none motion-reduce:transition-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 focus-visible:ring-offset-2 focus-visible:ring-offset-gray-900">
                    <div class="relative overflow-hidden bg-gray-800 ring-1 ring-white/10 <%= shape %>">
                        <img src="<%= c.img %>" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" class="h-full w-full object-cover">
                        <% if (c.badge && c.live) { %>
                        <span class="absolute left-2 top-2 whitespace-nowrap rounded bg-red-600 px-1.5 py-0.5 text-xs font-bold tabular-nums text-white shadow">LIVE <%= c.badge %></span>
                        <% } else if (c.badge) { %>
                        <span class="absolute bottom-2 right-2 whitespace-nowrap rounded bg-black/80 px-1.5 py-0.5 text-xs font-semibold tabular-nums text-white"><%= c.badge %></span>
                        <% } %>
                    </div>
                    <p class="mt-2 line-clamp-2 text-[15px] font-semibold leading-snug transition-colors group-hover:text-blue-300"><%= c.title %></p>
                    <% if (c.sub) { %><p class="truncate text-[13px] text-gray-300"><%= c.sub %></p><% } %>
                    <% if (c.meta) { %><p class="truncate text-[13px] text-gray-400"><%= c.meta %></p><% } %>
                </a>
                <% }) %>
            </div>
            <% if (next) { %>
            <div class="mt-8 flex justify-center">
                <a href="<%= next %>" class="inline-flex min-h-[44px] w-full items-center justify-center rounded-full bg-white/10 px-8 text-sm font-semibold transition-colors hover:bg-white/20 motion-safe:active:scale-95 sm:w-auto focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 focus-visible:ring-offset-2 focus-visible:ring-offset-gray-900">もっと見る</a>
            </div>
            <% } %>
        </div>
    </main>
</body>
</html>
