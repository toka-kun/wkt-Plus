    <div id="app">
    <button class="back-button fixed top-5 left-5 z-40 bg-blue-500 hover:bg-blue-600 text-white font-semibold py-2 px-4 rounded-lg shadow-lg transform transition-all duration-300 ease-in-out flex items-center space-x-2" onclick="window.location.href='/wkt'">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        <span>戻る</span>
    </button>

    <main class="mx-auto max-w-2xl px-4 pb-20 pt-20">
        <h1 class="sr-only">X（Yahooリアルタイム検索）</h1>
    <form id="form" role="search" class="flex items-center gap-2">
            <button id="home" type="button" aria-label="ホーム（検索をリセット）" title="ホーム" class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400">
                <svg class="h-6 w-6 fill-current" aria-hidden="true"><use href="#i-house"/></svg>
            </button>
            <label for="q" class="sr-only">検索</label>
            <div class="relative min-w-0 flex-1">
                <input id="q" type="text" autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="search" placeholder="キーワード、もしくは id:ユーザー名 を入力..." class="h-12 w-full rounded-full border-0 bg-white/10 pl-5 pr-10 text-[1.2rem] text-white placeholder-gray-400 outline-none transition-[background-color,box-shadow] duration-300 focus:bg-white/30 focus:shadow-[0_0_8px_rgba(255,255,255,0.5)]">
                <button type="button" id="clearBtn" aria-label="入力を消す" class="absolute right-2 top-1/2 -translate-y-1/2 flex items-center justify-center h-6 w-6 rounded-full hover:bg-gray-400 text-white text-lg leading-none hidden focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 before:absolute before:-inset-2">×</button>
            </div>
            <button type="submit" aria-label="検索" class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400">
                <svg class="h-6 w-6 fill-current" aria-hidden="true"><use href="#i-magnifying-glass"/></svg>
            </button>
        </form>
        <p id="hint" class="mt-3 flex items-start gap-2 text-sm text-gray-400">
            <svg class="mt-0.5 h-4 w-4 shrink-0 fill-current" aria-hidden="true"><use href="#i-info"/></svg>
            <span><code class="rounded bg-gray-800 px-1.5 py-0.5 text-gray-200">id:ユーザー名</code> または <code class="rounded bg-gray-800 px-1.5 py-0.5 text-gray-200">@ユーザー名</code> で、そのアカウントの投稿だけを表示します。名前やアイコンを押しても同じです。</span>
        </p>
        <div id="resultbar" class="hidden mt-6">
            <div class="flex items-center justify-between gap-3">
                <h2 class="flex min-w-0 items-center gap-2 text-lg font-bold">
                    <svg id="resultIcon" class="h-5 w-5 shrink-0 fill-current text-blue-400" aria-hidden="true"><use href="#i-magnifying-glass"/></svg>
                    <span id="resultLabel" class="truncate"></span>
                </h2>
                <div class="flex shrink-0 items-center gap-1">
                    <span id="resultCount" class="text-sm tabular-nums text-gray-400"></span>
                    <button id="refresh" type="button" aria-label="最新の投稿に更新" title="更新" class="flex h-11 w-11 items-center justify-center rounded-full text-gray-300 transition-colors hover:bg-gray-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400">
                        <svg class="h-5 w-5 fill-current" aria-hidden="true"><use href="#i-arrow-clockwise"/></svg>
                    </button>
                </div>
            </div>
        </div>
        <div class="mt-4 space-y-3">
            <div id="status" class="space-y-3" aria-live="polite"></div>
            <div id="list" class="space-y-3"></div>
        </div>
        <div id="moreWrap" class="hidden mt-5">
            <button id="more" type="button" class="flex h-12 w-full items-center justify-center gap-2 rounded-xl border border-gray-700 bg-gray-800 font-semibold transition-colors hover:bg-gray-700 disabled:opacity-60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400">
                <span id="moreLabel">もっと読み込む</span>
                <svg class="h-5 w-5 fill-current" aria-hidden="true"><use href="#i-caret-down"/></svg>
            </button>
        </div>
        <p id="note" class="mt-5 text-center text-sm text-gray-400" aria-live="polite"></p>
    </main>
    </div>

    <!-- 詳細・返信 -->
    <div id="modal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-black/70" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
        <div class="mx-auto min-h-full max-w-2xl sm:px-4 sm:py-8">
            <div class="x-pop min-h-screen bg-gray-900 sm:min-h-0 sm:rounded-2xl sm:border sm:border-gray-700">
                <div class="sticky top-0 z-10 flex items-center justify-between gap-3 border-b border-gray-800 bg-gray-900 px-4 py-2 sm:rounded-t-2xl">
                    <h2 id="modalTitle" class="font-bold">ツイート詳細</h2>
                    <button id="close" type="button" class="inline-flex h-11 items-center gap-1.5 rounded-lg px-3 font-semibold text-gray-200 transition-colors hover:bg-gray-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400">
                        <svg class="h-5 w-5 fill-current" aria-hidden="true"><use href="#i-x"/></svg><span>閉じる</span>
                    </button>
                </div>
                <div class="p-4">
                    <div id="detail"></div>
                    <h3 id="replyTitle" class="mb-3 mt-6 text-sm font-bold text-gray-300"></h3>
                    <div id="replies" class="space-y-3"></div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const $ = (id) => document.getElementById(id);
        const PAGE = 40;
        let q = "", start = 0, token = 0, detailToken = 0, detailId = null;
        const seen = new Set();

        // ---------- 小物 ----------
        function el(tag, cls, text) {
            const e = document.createElement(tag);
            if (cls) e.className = cls;
            if (text != null) e.textContent = text;
            return e;
        }
        // 外部から来たURLは http(s) のものだけ使う (javascript: などを防ぐ)
        const safeUrl = (u) => (/^https?:\/\//i.test(u || "") ? u : "");

        function ago(ts) {
            const s = Math.floor(Date.now() / 1000) - ts;
            if (s < 60) return Math.max(s, 0) + "秒前";
            if (s < 3600) return Math.floor(s / 60) + "分前";
            if (s < 86400) return Math.floor(s / 3600) + "時間前";
            return new Date(ts * 1000).toLocaleString("ja-JP");
        }

        // 「@名前」だけ入力されたら「id:名前」にする
        function normalize(s) {
            s = s.trim();
            const m = s.match(/^[@＠](\w{1,15})$/);
            return m ? "id:" + m[1] : s;
        }

        async function api(path) {
            const r = await fetch(path);
            const data = await r.json().catch(() => ({}));
            if (!r.ok) throw new Error(data.error || "取得に失敗しました。");
            return data;
        }

        // @ユーザー名 は「id:ユーザー名」、#ハッシュタグ は「#タグ」の検索へ飛べるリンクにする
        const TOKEN = /([@＠][A-Za-z0-9_]{1,15})|([#＃][\p{L}\p{N}\p{M}_]*[\p{L}\p{M}_][\p{L}\p{N}\p{M}_]*)/gu;
        function tokenLink(label, query, hl) {
            const a = el("a", "text-blue-400 hover:underline " + FOCUS + (hl ? " rounded bg-yellow-400/25 px-0.5" : ""), label);
            a.href = "?q=" + encodeURIComponent(query); // 新しいタブでも開ける
            a.onclick = (ev) => {
                if (ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.altKey || ev.button) return;
                ev.preventDefault();
                search(query);
            };
            return a;
        }
        function put(node, t, hl) {
            node.appendChild(hl ? el("mark", "rounded bg-yellow-400/25 px-0.5 text-yellow-100", t) : document.createTextNode(t));
        }
        // 検索語のハイライト用マーカー(\tSTART\t ～ \tEND\t)を <mark> に変え、@ と # をリンクにする。必ず textContent / TextNode で入れる
        function fill(node, text) {
            text.split(/\tSTART\t|\tEND\t/).forEach((part, i) => {
                if (!part) return;
                const hl = i % 2 === 1;
                let last = 0, m;
                TOKEN.lastIndex = 0;
                while ((m = TOKEN.exec(part))) {
                    const prev = part[m.index - 1] || "";
                    // 直前が英数字などなら(メールアドレスの途中など)リンクにしない
                    if (prev && (m[1] ? /[\w@＠]/ : /[\p{L}\p{N}\p{M}_&#＃]/u).test(prev)) continue;
                    if (m.index > last) put(node, part.slice(last, m.index), hl);
                    node.appendChild(tokenLink(m[0], m[1] ? "id:" + m[0].slice(1) : m[0].replace(/^＃/, "#"), hl));
                    last = m.index + m[0].length;
                }
                if (last < part.length) put(node, part.slice(last), hl);
            });
        }

        // ---------- 動画 (HLS) ----------
        let hlsLoading = null;
        function loadHls() {
            if (window.Hls) return Promise.resolve();
            if (!hlsLoading) {
                hlsLoading = new Promise((ok, ng) => {
                    const s = document.createElement("script");
                    s.src = "https://cdn.jsdelivr.net/npm/hls.js@1";
                    s.onload = ok;
                    s.onerror = ng;
                    document.head.appendChild(s);
                });
            }
            return hlsLoading;
        }
        async function playVideo(cell, src, poster) {
            src = safeUrl(src);
            if (!src) return;
            const v = el("video", "w-full max-h-96 bg-black");
            v.controls = true;
            v.playsInline = true;
            v.poster = poster;
            cell.textContent = "";
            cell.appendChild(v);
            if (v.canPlayType("application/vnd.apple.mpegurl")) {
                v.src = src;
            } else {
                try {
                    await loadHls();
                    if (!window.Hls.isSupported()) throw new Error("unsupported");
                    const hls = new window.Hls();
                    hls.loadSource(src);
                    hls.attachMedia(v);
                } catch (e) {
                    cell.textContent = "この動画は再生できませんでした。「Xで開く」から見てください。";
                    return;
                }
            }
            v.play().catch(() => {});
        }

        // ---------- アイコン (上のスプライトを参照) ----------
        const NS = "http://www.w3.org/2000/svg";
        function icon(name, cls) {
            const svg = document.createElementNS(NS, "svg");
            svg.setAttribute("class", "fill-current " + (cls || "h-5 w-5"));
            svg.setAttribute("aria-hidden", "true");
            const use = document.createElementNS(NS, "use");
            use.setAttribute("href", "#i-" + name);
            svg.appendChild(use);
            return svg;
        }
        const nf = new Intl.NumberFormat("ja-JP", { notation: "compact", maximumFractionDigits: 1 });
        const FOCUS = "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400";
        const ACT = "inline-flex min-h-[44px] items-center gap-1 rounded-lg px-3 text-sm font-semibold text-blue-400 transition-colors hover:bg-gray-700 hover:text-blue-300 " + FOCUS;

        // ---------- 画像・動画 ----------
        function media(list) {
            const multi = list.length > 1;
            const wrap = el("div", "mt-3 grid gap-2" + (multi ? " grid-cols-2" : ""));
            for (const m of list) {
                const it = m.item || {};
                const thumb = safeUrl(it.thumbnailImageUrl || m.metaImageUrl || it.mediaUrl);
                if (!thumb) continue;
                const v = it.sizes && it.sizes.viewer;
                // 先に縦横比を決めて、読み込み後にレイアウトがずれないようにする
                const ratio = multi ? 1 : (v && v.width && v.height ? Math.min(Math.max(v.width / v.height, 0.8), 2.2) : 16 / 9);
                const cell = el("div", "relative overflow-hidden rounded-xl border border-gray-700 bg-black");
                cell.style.aspectRatio = String(ratio);
                const isVideo = m.type === "video";
                const cls = "group block h-full w-full focus-visible:ring-inset " + FOCUS;
                const open = isVideo ? el("button", cls) : el("a", cls);
                if (isVideo) {
                    open.type = "button";
                    open.setAttribute("aria-label", "動画を再生");
                    open.onclick = () => playVideo(cell, it.mediaUrl, thumb);
                } else {
                    open.href = safeUrl(it.mediaUrl) || thumb;
                    open.target = "_blank";
                    open.rel = "noopener noreferrer";
                    open.setAttribute("aria-label", m.type === "youTube" ? "YouTubeの動画を開く" : "画像を開く");
                }
                const img = el("img", "absolute inset-0 h-full w-full object-cover");
                img.src = thumb;
                img.alt = "";
                img.setAttribute("loading", "lazy");
                img.setAttribute("referrerpolicy", "no-referrer");
                open.appendChild(img);
                if (isVideo || m.type === "youTube") {
                    const o = el("span", "absolute inset-0 flex items-center justify-center");
                    const c = el("span", "flex h-14 w-14 items-center justify-center rounded-full bg-black/60 text-white transition-colors group-hover:bg-black/80");
                    c.appendChild(icon("play", "h-7 w-7"));
                    o.appendChild(c);
                    open.appendChild(o);
                }
                cell.appendChild(open);
                wrap.appendChild(cell);
            }
            return wrap;
        }

        // ---------- リンクカード ----------
        function linkCard(u, href) {
            const a = el("a", "mt-3 flex items-center gap-3 rounded-xl border border-gray-700 p-3 text-sm transition-colors hover:bg-gray-700/50 " + FOCUS);
            a.href = href; a.target = "_blank"; a.rel = "noopener noreferrer";
            const th = el("span", "flex h-14 w-14 shrink-0 items-center justify-center overflow-hidden rounded-lg bg-gray-700 text-gray-300");
            const fallback = () => { th.textContent = ""; th.appendChild(icon("link-simple", "h-6 w-6")); };
            const im = (u.images || []).find((i) => i.width === i.height) || (u.images || [])[0];
            if (im && safeUrl(im.url)) {
                const img = el("img", "h-full w-full object-cover");
                img.src = im.url; img.alt = "";
                img.setAttribute("loading", "lazy"); img.setAttribute("referrerpolicy", "no-referrer");
                img.onerror = fallback;
                th.appendChild(img);
            } else fallback();
            const tx = el("span", "min-w-0");
            tx.appendChild(el("span", "block truncate text-xs text-gray-400", u.displayUrl || href));
            if (u.title) tx.appendChild(el("span", "line-clamp-2 font-semibold", u.title));
            a.append(th, tx);
            return a;
        }

        // ---------- 引用ツイート ----------
        function quote(t) {
            const b = el("div", "mt-3 rounded-xl border border-gray-700 bg-gray-900/50 p-3 text-sm");
            b.appendChild(el("div", "font-semibold text-gray-200", t.name + "  @" + t.screenName));
            const qp = el("p", "mt-1 whitespace-pre-wrap leading-relaxed");
            fill(qp, (t.displayTextBody || "").replace(/https?:\/\/t\.co\/\S+/g, "").trim());
            b.appendChild(qp);
            if (t.media && t.media.length) b.appendChild(media(t.media));
            const href = safeUrl(t.url);
            if (href) {
                const a = el("a", ACT + " -ml-3 mt-1");
                a.href = href; a.target = "_blank"; a.rel = "noopener noreferrer";
                a.append(icon("arrow-square-out", "h-4 w-4"), "Xで開く");
                b.appendChild(a);
            }
            return b;
        }

        // ---------- 1件のカード ----------
        function card(e, openable) {
            const box = el("article", "rounded-2xl border border-gray-700 bg-gray-800 p-4 transition-colors duration-200 hover:border-gray-600");
            const profile = () => search("id:" + e.screenName);

            // 上段: アイコン・名前・ID・時刻 (押すとそのユーザーの投稿だけを検索)
            const head = el("div", "flex gap-3");
            const av = el("button", "h-11 w-11 shrink-0 overflow-hidden rounded-full bg-gray-700 " + FOCUS);
            av.type = "button";
            av.setAttribute("aria-label", "@" + e.screenName + " の投稿だけを表示");
            if (safeUrl(e.profileImage)) {
                const im = el("img", "h-full w-full object-cover");
                im.src = e.profileImage; im.alt = "";
                im.setAttribute("loading", "lazy"); im.setAttribute("referrerpolicy", "no-referrer");
                av.appendChild(im);
            }
            av.onclick = profile;
            head.appendChild(av);

            const who = el("div", "min-w-0 flex-1");
            const l1 = el("div", "flex items-center gap-1.5");
            const nm = el("button", "min-w-0 truncate rounded text-left font-bold hover:underline " + FOCUS, e.name);
            nm.type = "button";
            nm.onclick = profile;
            l1.appendChild(nm);
            if (e.badge && e.badge.show) {
                const bd = el("span", "inline-flex shrink-0 " + (e.badge.type === "business" ? "text-yellow-500" : "text-blue-400"));
                bd.title = "認証済み";
                bd.append(icon("check-circle", "h-4 w-4"), el("span", "sr-only", "認証済み"));
                l1.appendChild(bd);
            }
            const l2 = el("div", "text-sm text-gray-400");
            const tm = el("time", "", ago(e.createdAt));
            tm.dateTime = new Date(e.createdAt * 1000).toISOString();
            tm.title = new Date(e.createdAt * 1000).toLocaleString("ja-JP");
            l2.append("@" + e.screenName + " · ", tm);
            who.append(l1, l2);
            head.appendChild(who);
            box.appendChild(head);

            // 返信先 (本文からは除かれているので別に出す): @名前は検索へ、「投稿を開く」は返信先の投稿の詳細へ
            const mentions = e.replyMentions || [];
            const jump = /^\d{1,25}$/.test(e.inReplyTo || "") && e.inReplyTo !== detailId; // 詳細表示中の投稿への返信なら、すでに見ているので出さない
            if (mentions.length || jump) {
                const r = el("div", "mt-3 flex flex-wrap items-center gap-x-2 text-sm text-gray-400");
                r.append(icon("arrow-bend-up-left", "h-4 w-4 shrink-0"), "返信先");
                for (const n of mentions) r.appendChild(tokenLink("@" + n, "id:" + n, false));
                if (jump) {
                    const j = el("button", ACT);
                    j.type = "button";
                    j.setAttribute("aria-label", "返信先の投稿を開く");
                    j.onclick = () => openDetail(e.inReplyTo);
                    j.append("投稿を開く", icon("caret-right", "h-4 w-4"));
                    r.appendChild(j);
                }
                box.appendChild(r);
            }

            // 本文 (URLは本文から除かれているので、下にリンクカードで出す)
            const text = e.displayTextFragments || e.displayTextBody || e.displayText || "";
            if (text.replace(/\tSTART\t|\tEND\t/g, "").trim()) {
                const body = el("p", "mt-3 whitespace-pre-wrap text-base leading-relaxed text-gray-100");
                fill(body, text);
                box.appendChild(body);
            }

            if (e.media && e.media.length) box.appendChild(media(e.media));
            for (const u of e.urls || []) {
                const href = safeUrl(u.expandedUrl);
                if (!href) continue;
                if (e.quotedTweet && /^https?:\/\/(x|twitter)\.com\/\w+\/status\//.test(href)) continue; // 引用元は下の引用欄で出す
                box.appendChild(linkCard(u, href));
            }
            if (e.quotedTweet) box.appendChild(quote(e.quotedTweet));

            // 下段: 数と操作
            const foot = el("div", "mt-4 flex flex-wrap items-center justify-between gap-x-4 border-t border-gray-700/70 pt-2");
            const stats = el("div", "flex items-center gap-5 text-sm text-gray-400");
            for (const [ic, label, n] of [["chat-circle", "返信", e.replyCount], ["repeat", "リポスト", e.rtCount], ["heart", "いいね", e.likesCount]]) {
                const st = el("span", "inline-flex items-center gap-1.5");
                st.append(icon(ic), el("span", "sr-only", label), el("span", "tabular-nums", nf.format(n || 0)));
                stats.appendChild(st);
            }
            foot.appendChild(stats);
            const acts = el("div", "flex items-center gap-1");
            if (openable) {
                const d = el("button", ACT);
                d.type = "button";
                d.append("詳細・返信", icon("caret-right", "h-4 w-4"));
                d.onclick = () => openDetail(e.id);
                acts.appendChild(d);
            }
            const href = safeUrl(e.url);
            if (href) {
                const x = el("a", ACT);
                x.href = href; x.target = "_blank"; x.rel = "noopener noreferrer";
                x.append(icon("arrow-square-out", "h-4 w-4"), "Xで開く");
                acts.appendChild(x);
            }
            foot.appendChild(acts);
            box.appendChild(foot);
            return box;
        }

        // ---------- 状態表示 (読み込み中 / 初期 / 空 / エラー) ----------
        function skeleton() {
            const sk = el("div", "animate-pulse rounded-2xl border border-gray-700 bg-gray-800 p-4 motion-reduce:animate-none");
            sk.setAttribute("aria-hidden", "true");
            const bar = (w, extra) => el("div", "h-3 rounded bg-gray-700 " + w + (extra ? " " + extra : ""));
            const head = el("div", "flex gap-3");
            const lines = el("div", "flex-1 space-y-2 pt-1");
            lines.append(bar("w-1/3"), bar("w-1/4"));
            head.append(el("div", "h-11 w-11 rounded-full bg-gray-700"), lines);
            sk.append(head, bar("w-full", "mt-4"), bar("w-5/6", "mt-2"), bar("w-2/3", "mt-2"));
            return sk;
        }
        function panel(ic, title, desc) {
            const p = el("div", "rounded-2xl border border-dashed border-gray-700 px-6 py-10 text-center");
            const c = el("div", "mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-gray-800 text-gray-300");
            c.appendChild(icon(ic, "h-6 w-6"));
            p.append(c, el("p", "font-semibold", title));
            if (desc) p.appendChild(el("p", "mt-1 text-sm text-gray-400", desc));
            return p;
        }
        // ---------- トレンド (最初の画面) ----------
        let trends = null; // 最後に取得した結果 {time, data}
        async function loadTrends(box, note) {
            const draw = (d) => {
                box.textContent = "";
                const t = new Date(d.updated);
                note.textContent = isNaN(t) ? "" : t.getHours() + ":" + String(t.getMinutes()).padStart(2, "0") + " 更新";
                if (!d.items.length) { box.appendChild(el("p", "text-sm text-gray-400", "トレンドはありません。")); return; }
                for (const w of d.items) {
                    const c = el("button", "min-h-[44px] rounded-full border border-gray-700 bg-gray-800 px-4 text-sm transition-colors hover:bg-gray-700 " + FOCUS, w);
                    c.type = "button";
                    c.onclick = () => search(w); // 押すと、その言葉で検索
                    box.appendChild(c);
                }
            };
            if (trends && Date.now() - trends.time < 5 * 60 * 1000) return draw(trends.data);
            box.textContent = "";
            for (let i = 0; i < 5; i++) box.appendChild(el("span", "h-11 w-24 animate-pulse rounded-full bg-gray-800 motion-reduce:animate-none"));
            box.setAttribute("aria-busy", "true");
            try {
                const d = await api("/other/x/api/trends");
                trends = { time: Date.now(), data: { updated: d.updated || "", items: d.items || [] } };
                if (box.isConnected) { box.removeAttribute("aria-busy"); draw(trends.data); }
            } catch (err) {
                if (!box.isConnected) return;
                box.removeAttribute("aria-busy");
                box.textContent = "";
                box.appendChild(el("p", "w-full text-sm text-gray-400", err.message));
                const b = el("button", ACT, "再試行");
                b.type = "button";
                b.onclick = () => loadTrends(box, note);
                box.appendChild(b);
            }
        }

        function showStatus(kind, msg) {
            const st = $("status");
            st.textContent = "";
            st.setAttribute("aria-busy", String(kind === "loading"));
            if (kind === "loading") { for (let i = 0; i < 3; i++) st.appendChild(skeleton()); return; }
            if (kind === "idle") {
                const p = panel("magnifying-glass", "キーワード、または id:ユーザー名 で検索してください。", "id:ユーザー名 で、そのアカウントの投稿だけを見られます。");
                const sec = el("div", "mt-6 border-t border-gray-700 pt-5");
                const h = el("h2", "mb-3 flex items-center justify-center gap-1.5 text-sm font-bold text-gray-300");
                const note = el("span", "ml-1 font-normal text-gray-400");
                h.append(icon("trend-up", "h-4 w-4"), "トレンド", note);
                const box = el("div", "flex flex-wrap justify-center gap-2");
                sec.append(h, box);
                p.appendChild(sec);
                loadTrends(box, note);
                st.appendChild(p);
            } else if (kind === "empty") {
                st.appendChild(panel("magnifying-glass", "投稿が見つかりませんでした。", /^id:/i.test(q) ? "ユーザー名のつづりを確認してください。" : "別のキーワードで試してください。"));
            } else if (kind === "error") {
                const p = panel("warning-circle", msg || "取得に失敗しました。", "時間をおいてから、もう一度お試しください。");
                p.setAttribute("role", "alert");
                const b = el("button", "mt-4 inline-flex h-11 items-center gap-2 rounded-lg bg-blue-600 px-4 font-semibold text-white transition-colors hover:bg-blue-500 " + FOCUS);
                b.type = "button";
                b.append(icon("arrow-clockwise"), "再試行");
                b.onclick = load;
                p.appendChild(b);
                st.appendChild(p);
            }
        }
        function setMore(state) { // "hidden" | "ready" | "loading"
            $("moreWrap").classList.toggle("hidden", state === "hidden");
            $("more").disabled = state === "loading";
            $("more").setAttribute("aria-busy", String(state === "loading"));
            $("moreLabel").textContent = state === "loading" ? "読み込み中…" : "もっと読み込む";
        }

        // ---------- 検索・続き読み込み ----------
        async function search(query, mode) { // mode: "init"=最初の表示 / "pop"=ブラウザの戻る・進む / 省略=履歴に追加
            closeDetail(false);
            q = normalize(query);
            $("q").value = q;
            toggleClear();
            if (mode !== "pop") {
                const next = location.pathname + (q ? "?q=" + encodeURIComponent(q) : "");
                const same = mode === "init" || next === location.pathname + location.search; // 同じ検索の更新は履歴を増やさない
                history[same ? "replaceState" : "pushState"](null, "", next);
            }
            $("hint").style.display = q ? "flex" : "none"; // 最初の画面には同じ説明があるので、ここでは出さない
            token++;
            start = 0;
            seen.clear();
            $("list").textContent = "";
            $("resultbar").classList.add("hidden");
            $("note").textContent = "";
            setMore("hidden");
            window.scrollTo(0, 0);
            if (!q) { showStatus("idle"); return; }
            await load();
        }

        async function load() {
            const my = token;
            const first = start === 0;
            $("note").textContent = "";
            if (first) { setMore("hidden"); showStatus("loading"); } else setMore("loading");
            try {
                const data = await api("/other/x/api/search?p=" + encodeURIComponent(q) + "&start=" + start);
                if (my !== token) return;
                const tl = data.timeline || {};
                const entries = tl.entry || [];
                const total = (tl.head && tl.head.totalResultsAvailable) || 0;
                // 取得の合間に新しい投稿が増えると同じ投稿が重なるので、IDで重複を除く
                for (const e of entries) {
                    if (seen.has(e.id)) continue;
                    seen.add(e.id);
                    $("list").appendChild(card(e, true));
                }
                start += entries.length;
                if (!seen.size) { showStatus("empty"); setMore("hidden"); return; }
                showStatus("none");
                const m = q.match(/^id:(\w+)$/i);
                $("resultLabel").textContent = m ? "@" + m[1] + " の投稿" : "「" + q + "」の検索結果";
                $("resultIcon").firstChild.setAttribute("href", m ? "#i-user-circle" : "#i-magnifying-glass");
                $("resultCount").textContent = seen.size + "件を表示中";
                $("resultbar").classList.remove("hidden");
                if (entries.length >= PAGE && start < total) setMore("ready");
                else { setMore("hidden"); $("note").textContent = "これ以上の投稿はありません。"; }
            } catch (err) {
                if (my !== token) return;
                if (first) showStatus("error", err.message);
                else { setMore("ready"); $("note").textContent = err.message + " もう一度押してください。"; }
            }
        }

        // ---------- 詳細・返信 ----------
        let lastFocus = null;
        function unavailable(id, title, desc) {
            const p = panel("warning-circle", title, desc);
            const a = el("a", ACT + " mt-3");
            a.href = "https://x.com/i/status/" + encodeURIComponent(id);
            a.target = "_blank"; a.rel = "noopener noreferrer";
            a.append(icon("arrow-square-out", "h-4 w-4"), "Xで開く");
            p.appendChild(a);
            return p;
        }
        async function openDetail(id) {
            const my = ++detailToken;
            if ($("modal").classList.contains("hidden")) lastFocus = document.activeElement;
            detailId = id;
            $("modal").scrollTop = 0;
            $("modal").classList.remove("hidden");
            document.body.style.overflow = "hidden";
            $("app").inert = true; // 背面にフォーカスが移らないようにする
            $("close").focus();
            $("detail").textContent = "";
            $("detail").appendChild(skeleton());
            $("replies").textContent = "";
            $("replyTitle").textContent = "";
            try {
                const data = await api("/other/x/api/tweet/" + id);
                if (my !== detailToken) return;
                $("detail").textContent = "";
                if (!data.bestTweet) {
                    $("detail").appendChild(unavailable(id, "ツイートが見つかりませんでした。", "削除されたか、Yahooリアルタイム検索に載っていない可能性があります。"));
                    return;
                }
                $("detail").appendChild(card(data.bestTweet, false));
                const rs = (data.timeline && data.timeline.entry) || [];
                $("replyTitle").textContent = rs.length ? "返信 " + rs.length + "件を表示" : "表示できる返信はありません。";
                rs.forEach((r) => $("replies").appendChild(card(r, false)));
            } catch (err) {
                if (my !== detailToken) return;
                $("detail").textContent = "";
                $("detail").appendChild(unavailable(id, err.message, "Xで直接開くこともできます。"));
            }
        }
        function closeDetail(restoreFocus) {
            detailToken++;
            detailId = null;
            if ($("modal").classList.contains("hidden")) return;
            $("modal").classList.add("hidden");
            document.body.style.overflow = "";
            $("app").inert = false;
            if (restoreFocus && lastFocus && document.contains(lastFocus)) lastFocus.focus();
            lastFocus = null;
        }

        // ---------- 起動 ----------
        $("form").addEventListener("submit", (ev) => { ev.preventDefault(); search($("q").value); });
        $("home").addEventListener("click", () => search("")); // 何も検索していない最初の状態に戻す
        // 入力があるときだけ「×」を出す。押すと入力欄を空にして、入力欄にフォーカスを戻す (tube/search.ejs と同じ動き)
        function toggleClear() { $("clearBtn").style.display = $("q").value ? "block" : "none"; }
        $("q").addEventListener("input", toggleClear);
        $("clearBtn").addEventListener("click", () => { $("q").value = ""; $("q").focus(); toggleClear(); });
        toggleClear();
        $("more").addEventListener("click", load);
        $("refresh").addEventListener("click", () => search(q));
        $("close").addEventListener("click", () => closeDetail(true));
        $("modal").addEventListener("click", (ev) => { if (ev.target === $("modal")) closeDetail(true); });
        document.addEventListener("keydown", (ev) => { if (ev.key === "Escape") closeDetail(true); });
        window.addEventListener("popstate", () => search(new URLSearchParams(location.search).get("q") || "", "pop"));
        search(new URLSearchParams(location.search).get("q") || "", "init");
    </script>
</body>
</html>
