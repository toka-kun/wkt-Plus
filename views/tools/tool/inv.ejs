<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>APIチェッカー</title>
    <script src="/js/tailwindcss.js"></script>
    <link rel="stylesheet" href="/css/page.css">
</head>
<body class="bg-gray-100 dark:bg-gray-900 text-gray-900 dark:text-white">
    
    <!-- 戻るボタン -->
    <button class="back-button fixed top-5 left-5 z-50 bg-blue-500 hover:bg-blue-600 text-white font-semibold py-2 px-4 rounded-lg shadow-lg transform transition-all duration-300 ease-in-out flex items-center space-x-2" onclick="window.location.href='/tools'">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        <span>戻る</span>
    </button>
  
    <!-- メインコンテナ -->
    <div class="w-full min-h-screen p-6 pt-16">
        <h1 class="text-3xl font-bold text-center mb-4">APIチェックツール</h1>
        
        <p class="text-gray-700 dark:text-gray-300 mt-2 mb-8 leading-relaxed text-center">
            InvidiousのURLを改行して入力してみてね。<br class="hidden sm:block">
            改行を入れたり整えたりするのにはAIを使うと楽かも。
        </p>
        
        <div class="w-full max-w-4xl mx-auto">
            <form id="apiForm" class="space-y-4">
                <label for="urls" class="block text-gray-700 dark:text-gray-300 text-lg font-medium">試すAPIのURL（改行区切り）:</label>
                <textarea name="urls" id="urls" rows="10" class="w-full p-4 border border-gray-300 dark:border-gray-600 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none dark:bg-gray-800 dark:text-white transition-colors" placeholder="https://...&#10;https://..."></textarea>
                <button id="submitButton" type="submit" class="w-full bg-blue-500 hover:bg-blue-600 text-white font-semibold py-3 px-6 rounded-lg shadow-md transition-all text-lg">チェック開始</button>
            </form>
            
            <!-- ローディングメッセージのデザイン -->
            <div id="loadingMessage" class="mt-6 hidden text-center">
                <p class="text-blue-500 text-lg font-semibold animate-pulse">APIをチェック中…</p>
                <p class="text-gray-500 dark:text-gray-400 text-sm mt-2">
                    URLが多いほど、チェックに時間がかかります。<br>
                    チェック中にこのページを閉じたり、ネットを切断したりしないで下さい。
                </p>
            </div>
            
            <p id="errorMessage" class="text-red-500 mt-4 hidden text-center text-lg font-semibold"></p>
            
            <div id="resultContainer" class="mt-8 hidden">
                <h2 class="text-2xl font-semibold text-center mb-4">結果</h2>
                <!-- HTMLを描画するため、<pre> を <div> に変更 -->
                <div id="result" class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-md border border-gray-200 dark:border-gray-700"></div>
            </div>
        </div>
    </div>

<script>
    document.getElementById("apiForm").addEventListener("submit", async function (event) {
        event.preventDefault();

        const errorMessage = document.getElementById("errorMessage");
        const loadingMessage = document.getElementById("loadingMessage");
        const submitButton = document.getElementById("submitButton");
        const resultContainer = document.getElementById("resultContainer");
        const result = document.getElementById("result");
        const urlsInput = document.getElementById("urls");

        // ボタンを無効化して連打を防ぐ
        errorMessage.classList.add("hidden");
        loadingMessage.classList.remove("hidden");
        submitButton.disabled = true;
        submitButton.classList.add("opacity-50", "cursor-not-allowed");
        resultContainer.classList.add("hidden");

        try {
            // 1. テキストエリアの文字列からURL（http:// または https://）だけをすべて抽出
            // JSONのダブルクォーテーション、シングルクォーテーション、カンマ、カッコ、空白を除外
            const rawText = urlsInput.value;
            const rawUrls = rawText.match(/https?:\/\/[^\s"',\]]+/g) || [];

            // 2. 重複したURLを排除する (Setを使用)
            const urls = [...new Set(rawUrls)];

            // 3. テキストエリアの表示を、抽出したきれいな改行区切りに書き換える
            urlsInput.value = urls.join("\n");

            // URLが空っぽの場合はエラーを出して処理を中断
            if (urls.length === 0) {
                throw new Error("有効なURLが見つかりませんでした。");
            }

            const response = await fetch("/tools/inv/check", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ urls }),
            });

            if (!response.ok) {
                throw new Error(await response.text());
            }

            const { successUrls, errorUrls } = await response.json();

            let html = "";

            if (successUrls.length) {
                // --- 正常に取得できたURLをABC順にソート ---
                successUrls.sort((a, b) => a.api.localeCompare(b.api));

                html += "<h3 class='text-green-600 dark:text-green-400 text-lg font-bold border-b border-gray-200 dark:border-gray-700 pb-2'>正常に取得できたURL <span class='text-sm font-normal'>(" + successUrls.length + "件)</span></h3><ul class='list-disc pl-5 mt-4 mb-6 space-y-2'>";
                successUrls.forEach(({ api, streamUrl }) => {
                    html += `<li><span class='font-medium'>${api}</span> <span class='mx-2 text-gray-400'>-</span> <a href='${streamUrl}' target='_blank' class='text-blue-500 underline hover:text-blue-400'>再生できるか確かめる</a></li>`;
                });
                html += "</ul>";
            }

            if (errorUrls.length) {
                html += "<h3 class='text-red-500 dark:text-red-400 text-lg font-bold border-b border-gray-200 dark:border-gray-700 pb-2 mt-6'>エラーが出たURL <span class='text-sm font-normal'>(" + errorUrls.length + "件)</span></h3>";
                
                // --- エラー理由ごとにグループ化する処理 ---
                const groupedErrors = {};
                errorUrls.forEach(err => {
                    const api = err.api || err;
                    const reason = err.reason || "不明なエラー";
                    
                    if (!groupedErrors[reason]) {
                        groupedErrors[reason] = [];
                    }
                    groupedErrors[reason].push(api);
                });

                html += "<div class='mt-4 space-y-6'>";
                
                // --- エラーの「理由」自体をABC順（五十音順）にソート ---
                const sortedReasons = Object.keys(groupedErrors).sort((a, b) => a.localeCompare(b));

                // グループ化されたエラーを展開してHTMLを生成
                for (const reason of sortedReasons) {
                    const apis = groupedErrors[reason];
                    
                    // --- その理由の中のURLもABC順にソート ---
                    apis.sort((a, b) => a.localeCompare(b));

                    html += `<div>`;
                    // エラーの理由を見出しとして表示
                    html += `<h4 class='font-semibold text-gray-800 dark:text-gray-200 text-md mb-2 bg-red-50 dark:bg-red-900/30 px-3 py-2 rounded-md border-l-4 border-red-500'>理由: ${reason} <span class='text-sm font-normal text-gray-500 dark:text-gray-400 ml-1'>(${apis.length}件)</span></h4>`;
                    // その理由に該当するURLのリストを表示
                    html += `<ul class='list-disc pl-6 space-y-1 text-gray-700 dark:text-gray-300'>`;
                    apis.forEach(api => {
                        html += `<li>${api}</li>`;
                    });
                    html += `</ul></div>`;
                }
                html += "</div>";
            }

            result.innerHTML = html;
            resultContainer.classList.remove("hidden");
        } catch (error) {
            errorMessage.textContent = error.message;
            errorMessage.classList.remove("hidden");
        } finally {
            // 結果が出たらボタンを再度有効化する
            loadingMessage.classList.add("hidden");
            submitButton.disabled = false;
            submitButton.classList.remove("opacity-50", "cursor-not-allowed");
        }
    });
</script>

</body>
</html>
